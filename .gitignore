# Build results
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# IDE / editor caches
.vs/
.idea/
*.swp
*.swo
clr-debug-pid-*.log
msbuild.binlog
*.binlog
/docs
# Scratch space, except the scripted-provider server: it is part of the eval contract the README
# documents. (`/scripts/*` rather than `/scripts` so the negation below can re-include one file —
# git never descends into an excluded directory.)
/scripts/*
!/scripts/fake_openai.py
# Eval outputs contain a seeded home with copied provider keys — never commit them.
/eval/results-*
# Benchmark result directories (methodology lives in the test suite, numbers are per-machine).
/benchmarks/results-*
# UX study outputs (per-run artifacts: screenshots, results.json)
/study/results-*

# Publish output
[Pp]ublish/
publish/
dist/
*.publish.xml
*.pubxml.user

# NuGet
*.nupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# Test results and coverage
[Tt]est[Rr]esult*/
TestResults/
coverage*.json
Coverage/
*.coverage
*.coveragexml
*.trx
BenchmarkDotNet.Artifacts/

# Runtime data (SQLite / local stores)
*.db
*.db-shm
*.db-wal

# OS cruft
.DS_Store
Thumbs.db
