        var requested = RequestedTab is "provider" or "custom" ? "providers" : RequestedTab;
        _tab = Tabs.Any(t => t.Id == requested) ? requested! : "providers";
    }

    // Focusing the first field also makes Escape work immediately (keydown lands inside the modal).
    private Microsoft.AspNetCore.Components.ElementReference _modalFirstField;
    private bool _focusModal;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The name field only renders for custom gateways; built-ins have nothing to focus.
        if (_focusModal && _providerModal is { IsCustom: true })
        {
            _focusModal = false;
            try { await _modalFirstField.FocusAsync(); }
            catch (Exception ex) when (ex is ObjectDisposedException or InvalidOperationException or JSException or JSDisconnectedException) { }
        }
        else
        {
            _focusModal = false;
        }
    }

    private static string CategoryLabel(string category) => category switch
    {
        "cloud" => "Cloud providers",
        "local" => "Local & self-hosted",
        _ => "Other",
    };

    /// <summary>Switches the default route: key stashing, base-URL swap and the new
    /// provider's model live in <see cref="HarnessSettings.SelectProvider"/> so the CLI's
    /// --provider override cannot drift from what the UI does.</summary>
    private void DefaultProviderChanged()
    {
        _settings.SelectProvider(_lastProvider, _settings.Provider);
        _lastProvider = _settings.Provider;
        RefreshModels();
    }

    /// <summary>Default-model dropdown options: the route's saved model list.
    /// Repairs the selection when it names a model the
    /// route no longer lists.</summary>
    private void RefreshModels()
    {
        _models = Facade.Harness.RuntimeModels(_settings.Provider);
        if (_models.All(m => m.Id != _settings.Model))
        {
            _settings.Model = _models.FirstOrDefault()?.Id ?? "";
        }
    }

    private bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        // Navigating away aborts a hung request instead of leaving it to time out.
        try { _modalListCts?.Cancel(); }
        catch (ObjectDisposedException) { }
    }

    private const string CustomSentinel = "__custom";

    private sealed record ProviderRow(
        string Id, string DisplayName, bool IsCustom, bool IsActive,
        string ApiTypeLabel, string BaseUrl, string ModelsSummary, string ModelsTitle,
        string KeyStatus, string KeyClass);

    /// <summary>Configured routes: the active provider, every built-in with a key, endpoint,
    /// model list or API-type override on file, and all custom gateways.</summary>
    private List<ProviderRow> ProviderRows => BuildProviderRows();

    private List<ProviderRow> BuildProviderRows()
    {
        var rows = new List<ProviderRow>();
        var builtinIds = new HashSet<string>(StringComparer.Ordinal) { _settings.Provider };
        foreach (var key in _settings.ProviderKeys.Keys) builtinIds.Add(key);
        foreach (var key in _settings.ProviderBaseUrls.Keys) builtinIds.Add(key);
        foreach (var key in _settings.DiscoveredModels.Keys) builtinIds.Add(key);
        foreach (var key in _settings.ProviderApiTypes.Keys) builtinIds.Add(key);
        foreach (var id in builtinIds)
        {
            if (_settings.CustomProviders.Any(c => c.Name.Equals(id, StringComparison.Ordinal))) continue;
            var info = ProviderCatalog.Info(id);
            if (info is null) continue;
            var models = Facade.Harness.RuntimeModels(id);
            var (keyStatus, keyClass) = BuiltinKeyBadge(id, info);
            rows.Add(new ProviderRow(
                id, info.Name, false, id == _settings.Provider,
                ProviderCatalog.ApiTypeLabel(HarnessBootstrapper.ResolveApiType(_settings, id)),
                _settings.BaseUrlFor(id),
                $"{models.Count} model{(models.Count == 1 ? "" : "s")}",
                models.Count == 0 ? "no models" : string.Join(", ", models.Select(m => m.Id)),
                keyStatus, keyClass));
        }
        foreach (var custom in _settings.CustomProviders)
        {
            var models = HarnessBootstrapper.CustomRouteModels(custom);
            var (keyStatus, keyClass) = CustomKeyBadge(custom);
            rows.Add(new ProviderRow(
                custom.Name, custom.Name, true, custom.Name == _settings.Provider,
                ProviderCatalog.ApiTypeLabel(custom.ApiType),
                custom.BaseUrl,
                $"{models.Count} model{(models.Count == 1 ? "" : "s")}",
                string.Join(", ", models.Select(m => m.Id)),
                keyStatus, keyClass));
        }
        return rows
            .OrderByDescending(r => r.IsActive)
            .ThenBy(r => r.DisplayName, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private (string Status, string Class) BuiltinKeyBadge(string id, ProviderInfo info)
    {
        var saved = !string.IsNullOrWhiteSpace(_settings.ProviderKeys.GetValueOrDefault(id))
            || (id == _settings.Provider && !string.IsNullOrWhiteSpace(_settings.ApiKey));
        if (saved) return ("saved", "ok");
        if (!string.IsNullOrWhiteSpace(_settings.ApiKeyFor(id))) return ("env", "env");
        if (info.Local) return ("not required", "optional");
        return ("missing", "missing");
    }

    private static (string Status, string Class) CustomKeyBadge(CustomProviderConfig custom)
    {
        if (!string.IsNullOrWhiteSpace(custom.ApiKey)) return ("saved", "ok");
        if (custom.ApiKeyEnv is { Length: > 0 } env && !string.IsNullOrWhiteSpace(Environment.GetEnvironmentVariable(env)))
            return ("env", "env");
        return ("none", "optional");
    }

    private sealed record ModalModelOption(string Id, string Name, bool FromApi, long? ContextWindow = null);

    /// <summary>Add/Edit provider dialog state. The checkbox set and the comma-separated text
    /// are two views of one selection: toggles rewrite the text, blurring the text re-ticks
    /// the boxes, and Save persists their union.</summary>
    private sealed class ProviderModalState
    {
        public string ProviderId { get; set; } = "";
        public bool IsCustom => ProviderId == CustomSentinel;
        public string CustomName { get; set; } = "";
        public string BaseUrl { get; set; } = "";
        public string ApiKey { get; set; } = "";
        public string ApiKeyEnv { get; set; } = "";
        public string ApiType { get; set; } = "openai";
        public List<ModalModelOption> Options { get; set; } = [];
        public HashSet<string> Selected { get; set; } = new(StringComparer.Ordinal);
        public Dictionary<string, (long? Window, int? Output)> Sizes { get; set; } = new(StringComparer.Ordinal);
        public string ModelsText { get; set; } = "";
        public string Filter { get; set; } = "";
        public bool Listing { get; set; }
        public string? ListError { get; set; }
        public int? ListedCount { get; set; }

        public string EffectiveId => IsCustom ? CustomName.Trim() : ProviderId;
        public string Title => IsCustom
            ? (CustomName.Trim().Length > 0 ? CustomName.Trim() : "custom gateway")
            : (ProviderCatalog.Info(ProviderId)?.Name ?? ProviderId);
        public bool KeyOptional => IsCustom
            ? ProviderCatalog.NormalizeApiType(ApiType) != "anthropic"
            : !ProviderCatalog.RequiresApiKey(ProviderId);
    }

    private CustomProviderConfig? _editingCustom;

    private void AddProvider()
    {
        var modal = new ProviderModalState();
        _providerModal = modal;
        _isNewProvider = true;
        _editingCustom = null;
        _providerModalError = "";
        _focusModal = true;
    }

    private void EditProvider(ProviderRow row)
    {
        ProviderModalState modal;
        if (row.IsCustom)
        {
            var custom = _settings.CustomProviders.First(c => c.Name == row.Id);
            _editingCustom = custom;
            modal = new ProviderModalState
            {
                ProviderId = CustomSentinel,
                CustomName = custom.Name,
                BaseUrl = custom.BaseUrl,
                ApiKey = custom.ApiKey ?? "",
                ApiKeyEnv = custom.ApiKeyEnv ?? "",
                ApiType = ProviderCatalog.NormalizeApiType(custom.ApiType),
            };
            foreach (var id in custom.Models)
            {
                var metadata = custom.ModelMetadata.FirstOrDefault(m => m.Id == id);
                modal.Options.Add(new ModalModelOption(id, id, false, metadata?.ContextWindowTokens));
                modal.Selected.Add(id);
                if (metadata is not null) modal.Sizes[id] = (metadata.ContextWindowTokens, metadata.MaxOutputTokens);
            }
            modal.ModelsText = string.Join(", ", custom.Models);
        }
        else
        {
            _editingCustom = null;
            modal = new ProviderModalState { ProviderId = row.Id };
            PrefillModalForBuiltin(modal);
        }
        _providerModal = modal;
        _isNewProvider = false;
        _providerModalError = "";
        _focusModal = true;
    }

    /// <summary>Prefills the modal from catalog defaults plus whatever the settings already
    /// hold for the built-in: stashed key/endpoint, API-type override, and the saved model
    /// list. The dialog never shows catalog seeds — only ids that came from the API or the
    /// user; an empty route starts empty until List models runs or ids are pasted.</summary>
    private void PrefillModalForBuiltin(ProviderModalState modal)
    {
        var id = modal.ProviderId;
        var info = ProviderCatalog.Info(id);
        // The active route edits its live endpoint; any other built-in starts from its own
        // stashed URL or the catalog default — never the active route's URL.
        modal.BaseUrl = _settings.BaseUrlFor(id);
        modal.ApiType = HarnessBootstrapper.ResolveApiType(_settings, id);
        modal.ApiKey = id == _settings.Provider
            ? (_settings.ApiKey ?? _settings.ProviderKeys.GetValueOrDefault(id) ?? "")
            : (_settings.ProviderKeys.GetValueOrDefault(id) ?? "");
        modal.ApiKeyEnv = "";
        modal.Options.Clear();
        modal.Selected.Clear();
        modal.Sizes.Clear();
        modal.Filter = "";
        modal.ListError = null;
        modal.ListedCount = null;
        if (_settings.DiscoveredModels.TryGetValue(id, out var found) && found.Count > 0)
        {
            var byId = ProviderCatalog.For(id, modal.BaseUrl).ToDictionary(m => m.Id, m => m, StringComparer.Ordinal);
            foreach (var entry in found)
            {
                // Display names/sizes may come from the catalog for a real id; the id itself
                // is only ever listed because discovery or the user put it there.
                byId.TryGetValue(entry.Id, out var known);
                modal.Options.Add(new ModalModelOption(entry.Id, known?.Name ?? entry.Id, false,
                    entry.ContextWindowTokens ?? known?.ContextWindowTokens));
                modal.Selected.Add(entry.Id);
                if (entry.ContextWindowTokens is not null || entry.MaxOutputTokens is not null)
                    modal.Sizes[entry.Id] = (entry.ContextWindowTokens, entry.MaxOutputTokens);
            }
        }
        else if (!_settings.DiscoveredModels.ContainsKey(id) && id == _settings.Provider
            && !string.IsNullOrWhiteSpace(_settings.Model))
        {
            modal.Options.Add(new ModalModelOption(_settings.Model, _settings.Model, false));
            modal.Selected.Add(_settings.Model);
        }
        modal.ModelsText = string.Join(", ", SelectedModalIdsInOrder(modal));
    }

    private void ModalProviderChanged(ChangeEventArgs e)
    {
        var modal = _providerModal;
        if (modal is null) return;
        modal.ProviderId = e.Value?.ToString() ?? "";
        _providerModalError = "";
        if (modal.IsCustom)
        {
            modal.CustomName = "";
            modal.BaseUrl = "";
            modal.ApiKey = "";
            modal.ApiKeyEnv = "";
            modal.ApiType = "openai";
            modal.Options.Clear();
            modal.Selected.Clear();
            modal.Sizes.Clear();
            modal.ModelsText = "";
            modal.Filter = "";
            modal.ListError = null;
            modal.ListedCount = null;
            _focusModal = true;
        }
        else
        {
            PrefillModalForBuiltin(modal);
        }
    }

    /// <summary>Base-URL shape hint for custom gateways. Either the endpoint root or the
    /// full versioned URL works — the call path is appended without doubling.</summary>
    private string ModalBaseUrlHint => _providerModal is { IsCustom: true } modal
        ? ProviderCatalog.NormalizeApiType(modal.ApiType) == "anthropic"
            ? "(…/anthropic or …/anthropic/v1 — /messages is appended)"
            : "(include /v1 for OpenAI-compatible gateways)"
        : "";

    private string? ModalDefaultBaseUrl => _providerModal is { IsCustom: false } modal
        ? ProviderCatalog.Info(modal.ProviderId)?.DefaultBaseUrl
        : null;

    private string? ModalCatalogEnv => _providerModal is { IsCustom: false } modal
        ? ProviderCatalog.Info(modal.ProviderId)?.ApiKeyEnv
        : null;

    private void ModalResetBaseUrl()
    {
        if (_providerModal is not null && ModalDefaultBaseUrl is { Length: > 0 } def)
            _providerModal.BaseUrl = def;
    }

    private bool FilteringModal => _providerModal?.Filter.Trim().Length > 0;

    /// <summary>Checklist rows matching the filter (name or id, case-insensitive); the whole
    /// list when the filter is empty. Bulk actions operate on exactly this set.</summary>
    private List<ModalModelOption> FilteredModalOptions()
    {
        var modal = _providerModal;
        if (modal is null) return [];
        var query = modal.Filter.Trim();
        if (query.Length == 0) return modal.Options;
        return modal.Options
            .Where(o => o.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                || o.Id.Contains(query, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void ToggleModalModel(string id, object? value)
    {
        var modal = _providerModal;
        if (modal is null) return;
        MergeModalTextIntoSelection(modal);
        if (value is true) modal.Selected.Add(id);
        else modal.Selected.Remove(id);
        modal.ModelsText = string.Join(", ", SelectedModalIdsInOrder(modal));
    }

    private void SelectModalFiltered()
    {
        var modal = _providerModal;
        if (modal is null) return;
        MergeModalTextIntoSelection(modal);
        foreach (var option in FilteredModalOptions()) modal.Selected.Add(option.Id);
        modal.ModelsText = string.Join(", ", SelectedModalIdsInOrder(modal));
    }

    private void ClearModalSelected()
    {
        var modal = _providerModal;
        if (modal is null) return;
        MergeModalTextIntoSelection(modal);
        foreach (var option in FilteredModalOptions()) modal.Selected.Remove(option.Id);
        modal.ModelsText = string.Join(", ", SelectedModalIdsInOrder(modal));
    }

    /// <summary>Folds typed-but-unblurred ids into the checkbox set (adding checklist rows
    /// for unknown ids) so a toggle or bulk action never drops them from the rewrite.</summary>
    private static void MergeModalTextIntoSelection(ProviderModalState modal)
    {
        foreach (var typed in ParseModelIds(modal.ModelsText))
        {
            modal.Selected.Add(typed);
            if (!modal.Options.Any(o => o.Id.Equals(typed, StringComparison.Ordinal)))
                modal.Options.Add(new ModalModelOption(typed, typed, false));
        }
    }

    /// <summary>Compact context-window label for a checklist row ("1M", "262K").</summary>
    private static string FormatContextWindow(long tokens) => tokens switch
    {
        >= 1_000_000 => $"{tokens / 1_000_000.0:0.#}M",
        >= 1_000 => $"{tokens / 1000}K",
        _ => tokens.ToString(),
    };

    private void ModalModelsTextBlurred()
    {
        var modal = _providerModal;
        if (modal is null) return;
        var parsed = ParseModelIds(modal.ModelsText);
        modal.Selected = new HashSet<string>(parsed, StringComparer.Ordinal);
        foreach (var id in parsed)
        {
            if (!modal.Options.Any(o => o.Id.Equals(id, StringComparison.Ordinal)))
                modal.Options.Add(new ModalModelOption(id, id, false));
        }
        modal.ModelsText = string.Join(", ", parsed);
    }

    private static List<string> SelectedModalIdsInOrder(ProviderModalState modal)
    {
        var ordered = new List<string>();
        foreach (var option in modal.Options)
            if (modal.Selected.Contains(option.Id)) ordered.Add(option.Id);
        foreach (var id in modal.Selected)
            if (!ordered.Contains(id, StringComparer.Ordinal)) ordered.Add(id);
        return ordered;
    }

    private static List<string> ParseModelIds(string text)
    {
        var ids = new List<string>();
        var seen = new HashSet<string>(StringComparer.Ordinal);
        foreach (var part in text.Split([',', '\n', '\r', ';'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (seen.Add(part)) ids.Add(part);
        }
        return ids;
    }

    private System.Threading.CancellationTokenSource? _modalListCts;

    /// <summary>Replaces the preview with the API's current list. Save keeps exactly what
    /// the dialog shows; manually entered ids can be added after discovery.</summary>
    private async Task ListModalModels()
    {
        var modal = _providerModal;
        if (modal is null || modal.Listing) return;
        modal.Listing = true;
        modal.ListError = null;
        modal.ListedCount = null;
        _modalListCts = new System.Threading.CancellationTokenSource();
        try
        {
            var probeId = modal.EffectiveId.Length > 0 ? modal.EffectiveId : "custom";
            var apiKey = !string.IsNullOrWhiteSpace(modal.ApiKey) ? modal.ApiKey
                : modal.IsCustom
                    ? (!string.IsNullOrWhiteSpace(modal.ApiKeyEnv) ? Environment.GetEnvironmentVariable(modal.ApiKeyEnv) : null)
                    : _settings.ApiKeyFor(probeId);
            var (models, error) = await Facade.Harness.PreviewModelsAsync(
                probeId, modal.BaseUrl, apiKey ?? "", modal.ApiType, ct: _modalListCts.Token);
            if (error is not null)
            {
                modal.ListError = error;
            }
            else if (models is not null)
            {
                modal.Options.Clear();
                modal.Selected.Clear();
                modal.Sizes.Clear();
                var known = new HashSet<string>(StringComparer.Ordinal);
                foreach (var model in models)
                {
                    if (model.ContextWindowTokens is not null || model.MaxOutputTokens is not null)
                        modal.Sizes[model.Id] = (model.ContextWindowTokens, model.MaxOutputTokens);
                    if (known.Add(model.Id))
                    {
                        modal.Options.Add(new ModalModelOption(model.Id, model.Name, true, model.ContextWindowTokens));
                        modal.Selected.Add(model.Id);
                    }
                }
                modal.ListedCount = models.Count;
                modal.ModelsText = string.Join(", ", SelectedModalIdsInOrder(modal));
            }
        }
        catch (Exception ex)
        {
            modal.ListError = ex.Message;
        }
        finally
        {
            modal.Listing = false;
            _modalListCts?.Dispose();
            _modalListCts = null;
            if (!_disposed) StateHasChanged();
        }
    }

    private void CancelModalList()
    {
        try { _modalListCts?.Cancel(); }
        catch (ObjectDisposedException) { }
    }

    private void SaveProviderModal()
    {
        var modal = _providerModal!;
        var id = modal.EffectiveId;
        if (modal.IsCustom && id.Length == 0)
        {
            _providerModalError = "name is required";
            return;
        }
        if (!modal.IsCustom && ProviderCatalog.Info(id) is null)
        {
            _providerModalError = "choose a provider";
            return;
        }
        var baseUrl = modal.BaseUrl.Trim();
        if (baseUrl.Length == 0)
        {
            _providerModalError = "base URL is required";
            return;
        }
        if (!Uri.TryCreate(baseUrl, UriKind.Absolute, out var uri)
            || (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps))
        {
            _providerModalError = $"'{baseUrl}' is not an absolute http(s) URL — include the scheme, e.g. https://host/v1";
            return;
        }
        var renaming = _isNewProvider || _editingCustom is null || !_editingCustom.Name.Equals(id, StringComparison.OrdinalIgnoreCase);
        if (modal.IsCustom && renaming
            && (ProviderCatalog.Info(id) is not null
                || _settings.CustomProviders.Any(c => c != _editingCustom && c.Name.Equals(id, StringComparison.OrdinalIgnoreCase))))
        {
            _providerModalError = $"'{id}' is already a provider name";
            return;
        }
        ModalModelsTextBlurred(); // typed ids join the selection
        var finalIds = SelectedModalIdsInOrder(modal);
        var apiType = ProviderCatalog.NormalizeApiType(modal.ApiType);
        var metadata = finalIds.Select(fid => modal.Sizes.TryGetValue(fid, out var size)
            ? new DiscoveredModelInfo(fid, size.Window, size.Output) : new DiscoveredModelInfo(fid)).ToList();
        var makeDefault = string.IsNullOrWhiteSpace(_settings.Provider)
            || (_editingCustom is not null && _settings.Provider == _editingCustom.Name);
        var selectedModel = finalIds.Contains(_settings.Model, StringComparer.Ordinal) ? _settings.Model : null;

        if (modal.IsCustom)
        {
            if (_editingCustom is not null) _settings.RemoveProvider(_editingCustom.Name);
            _settings.CustomProviders.Add(new CustomProviderConfig
            {
                Name = id,
                BaseUrl = baseUrl,
                ApiKey = modal.ApiKey.Trim().Length > 0 ? modal.ApiKey.Trim() : null,
                ApiKeyEnv = modal.ApiKeyEnv.Trim().Length > 0 ? modal.ApiKeyEnv.Trim() : null,
                ApiType = apiType,
                Models = finalIds,
                ModelMetadata = metadata,
            });
        }
        else
        {
            if (modal.ApiKey.Trim().Length > 0)
            {
                _settings.ProviderKeys[id] = modal.ApiKey.Trim();
                if (id == _settings.Provider) _settings.ApiKey = modal.ApiKey.Trim();
            }
            else
            {
                _settings.ProviderKeys.Remove(id);
                if (id == _settings.Provider) _settings.ApiKey = null;
            }
            _settings.ProviderBaseUrls[id] = baseUrl;
            if (id == _settings.Provider)
            {
                _settings.BaseUrl = baseUrl;
                _settings.BaseUrlProvider = id;
            }
            // The dialog always stores the wire explicitly: the dataview shows what is stored.
            _settings.ProviderApiTypes[id] = apiType;
            _settings.DiscoveredModels[id] = metadata;
        }

        if (makeDefault) _settings.SelectProvider(_settings.Provider, id, selectedModel);

        _editingCustom = null;
        _providerModal = null;
        _providerModalError = "";
        Facade.Harness.ApplyProviderSelection();
        SyncDefaultSelection();
        Facade.Harness.SaveSettings();
    }

    private void CloseProviderModal()
    {
        try { _modalListCts?.Cancel(); }
        catch (ObjectDisposedException) { }
        _providerModal = null;
        _editingCustom = null;
        _providerModalError = "";
    }

    private void OnModalKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseProviderModal();
    }

    private void RemoveProvider(ProviderRow row)
    {
        _settings.RemoveProvider(row.Id);
        Facade.Harness.ApplyProviderSelection();
        SyncDefaultSelection();
        Facade.Harness.SaveSettings();
        StateHasChanged();
    }

    /// <summary>Keeps the default-model dropdown in step after the table adds, edits,
    /// removes or rediscovers a route.</summary>
    private void SyncDefaultSelection()
    {
        RefreshModels();
        _lastProvider = _settings.Provider;
        Facade.Harness.ApplyDefaultSelection();
    }

    private string? _rowDiscovering;
    private string? _rowDiscoverError;

    private async Task DiscoverProviderRow(ProviderRow row)
    {
        if (_rowDiscovering is not null) return;
        _rowDiscovering = row.Id;
        _rowDiscoverError = null;
        try
        {
            // Saved-settings discovery: the bootstrapper persists the list and rebuilds the route.
            var (_, error) = await Facade.Harness.DiscoverModelsAsync(row.Id);
            if (error is not null) _rowDiscoverError = $"{row.Id}: {error}";
            else SyncDefaultSelection();
        }
        catch (Exception ex)
        {
            _rowDiscoverError = $"{row.Id}: {ex.Message}";
        }
        finally
        {
            _rowDiscovering = null;
            if (!_disposed) StateHasChanged();
        }
    }

