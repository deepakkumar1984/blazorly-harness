@page "/settings"
@using Blazorly.Harness.Web.Services
@using Blazorly.Harness.Tools
@inject SessionFacade Facade
@inject NavigationManager Navigation
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>Settings · Blazorly Harness</PageTitle>

<div class="settings-page">
    <div class="settings-topbar">
        <div class="settings-title">
            <button class="icon settings-back" title="Back to workspace" aria-label="Back to workspace" @onclick="GoBack">←</button>
            <div><span class="settings-eyebrow">PREFERENCES</span><h1>Settings</h1></div>
        </div>
        <div class="settings-actions">
            @if (_tab != "appearance")
            {
                <button class="primary" @onclick="Save">Save settings</button>
            }
        </div>
    </div>

    <nav class="settings-tabs" role="tablist" aria-label="Settings categories" @onkeydown="OnSettingsTabKey">
        @foreach (var (id, label) in Tabs)
        {
            <button type="button" id="@($"settings-tab-{id}")" role="tab" tabindex="@(_tab == id ? 0 : -1)" aria-selected="@(_tab == id ? "true" : "false")" aria-controls="@($"settings-panel-{id}")" class="settings-tab @(_tab == id ? "on" : "")" @onclick="() => SelectTab(id)">@label</button>
        }
    </nav>

    <div class="@(_tab == "appearance" ? "appearance-panel" : "settings-form")" id="@($"settings-panel-{_tab}")" role="tabpanel" aria-labelledby="@($"settings-tab-{_tab}")">
        @switch (_tab)
        {
            case "appearance":
                <AppearanceSettings />
                break;

            case "provider":
                <p class="settings-note">Provider, model and API key for new sessions. Keys are kept per provider —
                    configure several and every one of them stays selectable from the session topbar.
                    Saved to <code>~/.blazorly/settings.json</code>.</p>

                <label>
                    <span>Provider</span>
                    <select @bind="_settings.Provider" @bind:after="ProviderChanged">
                        @foreach (var category in ProviderCatalog.Categories)
                        {
                            var group = ProviderCatalog.All.Where(p => p.Category == category).ToList();
                            if (group.Count == 0) continue;
                            <optgroup label="@CategoryLabel(category)">
                                @foreach (var provider in group)
                                {
                                    <option value="@provider.Id">@provider.Name</option>
                                }
                            </optgroup>
                        }
                        @if (ProviderCatalog.Info(_settings.Provider) is { } current && !ProviderCatalog.Providers.Contains(current.Id))
                        {
                            // Retired ids (e.g. the old generic slot) stay selectable while active so the
                            // dropdown never misdisplays the current route; switching away is one-way.
                            <option value="@current.Id">@current.Name — pick a built-in or Custom provider to migrate</option>
                        }
                    </select>
                </label>
                @if (_providerInfo is { } info)
                {
                    <div class="provider-meta">
                        @if (info.Local)
                        {
                            <span class="chip">runs on your machine</span>
                        }
                        else if (info.ApiKeyEnv is { Length: > 0 } env)
                        {
                            <span class="provider-meta-hint">key or env <code>@env</code></span>
                        }
                        @if (info.DefaultBaseUrl is { Length: > 0 })
                        {
                            <span class="provider-meta-hint">default <code>@info.DefaultBaseUrl</code></span>
                        }
                    </div>
                }

                <label>
                    <span>Model @(_discovered is { Count: > 0 } ? $"— {_discovered.Count} loaded from the {ProviderCatalog.Info(_settings.Provider)?.Name ?? _settings.Provider} API" : "")</span>
                    <select @bind="_settings.Model">
                        @if (_models.Count == 0)
                        {
                            <option value="@_settings.Model">@(NeedsKey && string.IsNullOrWhiteSpace(_settings.ApiKey) ? "— enter your API key to load models —" : "— load models below —")</option>
                        }
                        @foreach (var model in _models)
                        {
                            <option value="@model.Id">@model.Name</option>
                        }
                    </select>
                </label>

                <label>
                    <span>Base URL</span>
                    <input type="text" @bind="_settings.BaseUrl" @bind:event="oninput" @bind:after="BaseUrlEdited" />
                </label>
                @if (ProviderCatalog.Info(_settings.Provider)?.DefaultBaseUrl is { Length: > 0 } def
                    && _settings.BaseUrl.TrimEnd('/') != def.TrimEnd('/'))
                {
                    <div class="discover-row">
                        <button type="button" class="chip" @onclick='() => { _settings.BaseUrl = def; BaseUrlEdited(); }'>reset to @def</button>
                    </div>
                }
                @if (_providerInfo is not null)
                {
                    <label>
                        <span>API key @(KeyOptional ? "(optional)" : "")</span>
                        <input type="password" @bind="_settings.ApiKey" @bind:event="oninput" @onblur="ApiKeyBlurred"
                               placeholder="@(KeyOptional ? "sk-… — only if your server requires auth" : "sk-…")" />
                    </label>
                }
                <div class="discover-row">
                    <button type="button" class="ghost" @onclick="DiscoverModels" disabled="@_discovering">
                        @(_discovering ? "Loading…" : _discovered is { Count: > 0 } ? "Reload models" : "Load models from the API")
                    </button>
                    @if (_discovering)
                    {
                        <button type="button" class="ghost" @onclick="CancelDiscover">Cancel</button>
                    }
                    @if (_discoverError is not null)
                    {
                        <span class="discover-error">@_discoverError</span>
                    }
                    else if (_discovered is { Count: > 0 })
                    {
                        <span class="discover-ok">@_discovered.Count models: @string.Join(", ", _discovered.Take(6))@(_discovered.Count > 6 ? ", …" : "")</span>
                    }
                </div>
                break;

            case "custom":
                <p class="settings-note">Extra OpenAI-compatible routes registered beside the built-ins; each appears in the
                    per-session model picker.</p>
                <div class="custom-list">
                    @if (_settings.CustomProviders.Count == 0)
                    {
                        <div class="custom-empty">no custom providers yet</div>
                    }
                    @foreach (var custom in _settings.CustomProviders)
                    {
                        <div class="custom-row">
                            <div class="custom-row-main">
                                <span class="custom-row-name">@custom.Name</span>
                                <code class="custom-row-url">@custom.BaseUrl</code>
                            </div>
                            <span class="custom-row-models">@custom.Models.Count models</span>
                            <button type="button" class="ghost small" @onclick="() => DiscoverCustom(custom)" disabled="@(_customDiscovering is not null)">
                                @(_customDiscovering == custom.Name ? "Loading…" : "Discover")
                            </button>
                            <button type="button" class="ghost small" @onclick="() => EditCustom(custom)">Edit</button>
                            <button type="button" class="icon danger" title="Remove provider" @onclick='() => RemoveCustomProvider(custom)'>✕</button>
                        </div>
                    }
                </div>
                <div class="discover-row">
                    <button type="button" class="ghost" @onclick="AddCustomProvider">＋ Add custom provider</button>
                    @if (_customDiscoverError is not null)
                    {
                        <span class="discover-error">@_customDiscoverError</span>
                    }
                </div>
                break;

            case "context":
                <label>
                    <span>Session persistence backend</span>
                    <select @bind="_settings.Persistence">
                        <option value="jsonl">jsonl (one file per session)</option>
                        <option value="sqlite">sqlite (single database)</option>
                    </select>
                </label>
                <label>
                    <span>Context window tokens — fallback only; per-model info (API/catalog) takes priority</span>
                    <input type="number" @bind="_settings.ContextWindowTokens" />
                </label>
                <label>
                    <span>Max output tokens per request — clamped to the model's own ceiling when known</span>
                    <input type="number" @bind="_settings.MaxOutputTokens" />
                </label>
                <label>
                    <span>Compaction threshold (fraction of the window)</span>
                    <input type="number" step="0.05" min="0.2" max="0.95" @bind="_settings.CompactionThreshold" />
                </label>
                <label>
                    <span>Tool-output spill threshold (characters)</span>
                    <input type="number" @bind="_settings.SpillThresholdChars" />
                </label>
                <label>
                    <span>Usage telemetry</span>
                    <div class="settings-toggles">
                        <label class="toggle">
                            <input type="checkbox" checked="@_settings.TelemetryEnabled" @onchange="e => _settings.TelemetryEnabled = e.Value is true" />
                            <span>Local-only usage aggregates (turns/tokens/tool calls); nothing leaves the machine</span>
                        </label>
                    </div>
                </label>
                break;

            case "capabilities":
                <label>
                    <span>Capabilities</span>
                    <div class="settings-toggles">
                        @foreach (var (key, label) in Toggles)
                        {
                            <label class="toggle">
                                <input type="checkbox" checked="@(GetToggle(key))" @onchange="e => SetToggle(key, e.Value)" />
                                <span>@label</span>
                            </label>
                        }
                    </div>
                </label>
                @if (_settings.EnableWeb)
                {
                    <label>
                        <span>Web search backend</span>
                        <select @bind="_settings.WebSearchBackend">
                            <option value="duckduckgo">DuckDuckGo (keyless)</option>
                            <option value="tavily">Tavily (API key)</option>
                            <option value="brave">Brave (API key)</option>
                        </select>
                    </label>
                    @if (_settings.WebSearchBackend == "tavily")
                    {
                        <label>
                            <span>Tavily API key</span>
                            <input type="password" @bind="_settings.TavilyApiKey" @bind:event="oninput" placeholder="tvly-…" />
                        </label>
                        <div class="discover-row"><span class="provider-meta-hint">or env <code>@_settings.TavilyApiKeyEnv</code></span></div>
                    }
                    @if (_settings.WebSearchBackend == "brave")
                    {
                        <label>
                            <span>Brave API key</span>
                            <input type="password" @bind="_settings.BraveApiKey" @bind:event="oninput" placeholder="BSA…" />
                        </label>
                        <div class="discover-row"><span class="provider-meta-hint">or env <code>@_settings.BraveApiKeyEnv</code></span></div>
                    }
                    <p class="settings-note">Search backend changes apply after the app restarts.</p>
                }
                <label>
                    <span>Decision model (System One)</span>
                    <div class="settings-toggles">
                        <label class="toggle">
                            <input type="checkbox" checked="@_settings.EnableSystemOne" @onchange="e => _settings.EnableSystemOne = e.Value is true" />
                            <span>Use a small calibrated model for judgment calls</span>
                        </label>
                    </div>
                </label>
                @if (_settings.EnableSystemOne)
                {
                    <label>
                        <span>System One API key</span>
                        <input type="password" @bind="_settings.SystemOneApiKey" @bind:event="oninput" placeholder="tsk-…" />
                    </label>
                    <div class="discover-row"><span class="provider-meta-hint">or env <code>@_settings.SystemOneApiKeyEnv</code></span></div>
                    <label>
                        <span>What it decides</span>
                        <div class="settings-toggles">
                            @foreach (var (key, label) in DecisionSeams)
                            {
                                <label class="toggle">
                                    <input type="checkbox" checked="@(SeamOn(key))" @onchange="e => SetSeam(key, e.Value is true)" />
                                    <span>@label</span>
                                </label>
                            }
                        </div>
                    </label>
                    <p class="settings-note">On timeout or error it silently falls back to the built-in heuristics, so a broken key never breaks a session. Verify the endpoint with <code>blazorly decisions probe</code>; changes apply after the app restarts.</p>
                    <details class="settings-advanced">
                        <summary>Advanced — endpoint &amp; calibration</summary>
                        <label>
                            <span>Base URL</span>
                            <input type="text" @bind="_settings.SystemOneBaseUrl" @bind:event="oninput" />
                        </label>
                        <label>
                            <span>Endpoint path</span>
                            <input type="text" @bind="_settings.SystemOnePath" @bind:event="oninput" />
                        </label>
                        <label>
                            <span>Model (blank = service default)</span>
                            <input type="text" @bind="_settings.SystemOneModel" @bind:event="oninput" placeholder="jev-1" />
                        </label>
                        <label>
                            <span>Auth header</span>
                            <select @bind="_settings.SystemOneAuthStyle">
                                <option value="bearer">Authorization: Bearer</option>
                                <option value="apikey">X-API-Key</option>
                            </select>
                        </label>
                        <label>
                            <span>Timeout (ms)</span>
                            <input type="number" min="100" max="10000" step="100" @bind="_settings.SystemOneTimeoutMs" />
                        </label>
                        <label>
                            <span>Auto-plan engages at P ≥</span>
                            <input type="number" min="0.5" max="1" step="0.05" @bind="_settings.AutoPlanEngageAt" />
                        </label>
                        <label>
                            <span>Auto-plan skips at P ≤</span>
                            <input type="number" min="0" max="0.5" step="0.05" @bind="_settings.AutoPlanSkipAt" />
                        </label>
                        <label>
                            <span>Risk gate parks calls at P(risky) ≥</span>
                            <input type="number" min="0" max="1" step="0.05" @bind="_settings.RiskGateThreshold" />
                        </label>
                        <p class="settings-note">Between the two auto-plan bands the model abstains and the built-in heuristic decides. The risk gate is escalate-only: it can turn an allowed call into an approval prompt, never the reverse, and stands down on timeout, error, and in headless runs.</p>
                    </details>
                }
                <label>
                    <span>Tool gate</span>
                    <div class="settings-toggles">
                        <label class="toggle">
                            <input type="checkbox" checked="@_settings.EnableToolGate" @onchange="e => _settings.EnableToolGate = e.Value is true" />
                            <span>Prune the per-request tool list to what the task needs (large tool sets only)</span>
                        </label>
                    </div>
                </label>
                @if (_settings.EnableToolGate)
                {
                    <details class="settings-advanced">
                        <summary>Advanced — gate sizing</summary>
                        <label>
                            <span>Engage above (visible tools)</span>
                            <input type="number" min="5" max="200" @bind="_settings.ToolGateMaxTools" />
                        </label>
                        <label>
                            <span>Shortlist size</span>
                            <input type="number" min="5" max="100" @bind="_settings.ToolGateKeep" />
                        </label>
                    </details>
                }
                <p class="settings-note">Pure code by default — no AI calls. Any failure sends the full tool list, exactly the pre-gate behaviour. Add <code>"tool-gate"</code> to the System One seams in <code>settings.json</code> to let the decision model handle ambiguous briefs.</p>
                break;

            case "sandbox":
                <label>
                    <span>Default permission preset (new sessions)</span>
                    <select @bind="_settings.SandboxMode">
                        <option value="@SandboxPolicy.FullAccess">full access</option>
                        <option value="@SandboxPolicy.WorkspaceWrite">workspace-write</option>
                        <option value="@SandboxPolicy.ReadOnly">read-only</option>
                    </select>
                </label>
                <label>
                    <span>Hosts that cannot confine (no Linux Landlock)</span>
                    <div class="settings-toggles">
                        <label class="toggle">
                            <input type="checkbox" checked="@_settings.SandboxFailClosedWhenUnsupported" @onchange="e => _settings.SandboxFailClosedWhenUnsupported = e.Value is true" />
                            <span>Fail closed instead of running tools unconfined</span>
                        </label>
                    </div>
                    <p class="settings-note">Off by default: an unconfigured sandbox runs tools directly on macOS/Windows. Explicit per-session overrides always fail closed.</p>
                </label>
                <label>
                    <span>Remote sandbox (E2B)</span>
                    <div class="settings-toggles">
                        <label class="toggle">
                            <input type="checkbox" checked="@_settings.EnableE2b" @onchange="e => _settings.EnableE2b = e.Value is true" />
                            <span>Run tools on E2B sandboxes instead of this machine</span>
                        </label>
                    </div>
                </label>
                @if (_settings.EnableE2b)
                {
                    <label>
                        <span>E2B API key</span>
                        <input type="password" @bind="_settings.E2bApiKey" @bind:event="oninput" placeholder="e2b_…" />
                    </label>
                    <div class="discover-row"><span class="provider-meta-hint">or env <code>@_settings.E2bApiKeyEnv</code></span></div>
                    <label>
                        <span>E2B template</span>
                        <input type="text" @bind="_settings.E2bTemplate" @bind:event="oninput" />
                    </label>
                    <label>
                        <span>E2B base URL</span>
                        <input type="text" @bind="_settings.E2bBaseUrl" @bind:event="oninput" />
                    </label>
                }
                <p class="settings-note">Remote-sandbox changes apply after the app restarts.</p>
                break;
        }
    </div>
</div>

@if (_customModal is not null)
{
    <div class="modal-overlay" @onclick="CloseCustomModal">
        <div class="modal" role="dialog" aria-modal="true" aria-label="Custom provider" @onclick:stopPropagation="true" @onkeydown="OnModalKey">
            <div class="modal-head">
                <h3>@(_isNewCustom ? "Add custom provider" : $"Edit {_customModal.Name}")</h3>
                <button class="icon modal-close" title="Close (Esc)" @onclick="CloseCustomModal">✕</button>
            </div>
            @if (_customError is { Length: > 0 })
            {
                <div class="discover-error">@_customError</div>
            }
            <label class="modal-field">
                <span>Name (unique, used as the provider id)</span>
                <input type="text" @ref="_modalFirstField" @bind="_customModal.Name" @bind:event="oninput" placeholder="my-gateway" />
            </label>
            <label class="modal-field">
                <span>Base URL (OpenAI-compatible, include /v1)</span>
                <input type="text" @bind="_customModal.BaseUrl" @bind:event="oninput" placeholder="https://gateway.example.com/v1" />
            </label>
            <label class="modal-field">
                <span>API key (optional)</span>
                <input type="password" @bind="_customModal.ApiKey" @bind:event="oninput" />
            </label>
            <label class="modal-field">
                <span>API key environment variable (optional)</span>
                <input type="text" @bind="_customModal.ApiKeyEnv" @bind:event="oninput" placeholder="MY_GATEWAY_API_KEY" />
            </label>
            <label class="modal-field">
                <span>Model ids (comma separated — or leave blank and press Discover on the saved row)</span>
                <textarea rows="3" @bind="_customModal.ModelsText"></textarea>
            </label>
            <div class="modal-actions">
                <button class="primary" @onclick="SaveCustomModal">Save provider</button>
                <button class="ghost" @onclick="CloseCustomModal">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private static readonly (string Id, string Label)[] Tabs =
    [
        ("appearance", "Appearance"),
        ("provider", "Model & API"),
        ("custom", "Custom providers"),
        ("context", "Sessions & context"),
        ("capabilities", "Capabilities"),
        ("sandbox", "Permissions & sandbox"),
    ];

    private HarnessSettings _settings = new();
    private string _tab = "provider";
    private bool _providerTabVisited;
    [SupplyParameterFromQuery(Name = "tab")]
    public string? RequestedTab { get; set; }

    private void SelectTab(string id)
    {
        _tab = id;
        Navigation.NavigateTo($"/settings?tab={id}", replace: true);
    }

    private async Task OnSettingsTabKey(KeyboardEventArgs e)
    {
        if (e.Key is not ("ArrowLeft" or "ArrowRight" or "Home" or "End")) return;
        var index = Array.FindIndex(Tabs, t => t.Id == _tab);
        index = e.Key switch
        {
            "Home" => 0,
            "End" => Tabs.Length - 1,
            "ArrowRight" => (index + 1) % Tabs.Length,
            _ => (index - 1 + Tabs.Length) % Tabs.Length
        };
        SelectTab(Tabs[index].Id);
        try { await Js.InvokeVoidAsync("blazorly.focusById", $"settings-tab-{_tab}"); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException) { }
    }

    /// <summary>The decision seams the settings expose; the service also accepts "*".</summary>
    private static readonly (string Key, string Label)[] DecisionSeams =
    [
        ("auto-plan", "Plan first on complex briefs"),
        ("risk-gate", "Ask before risky commands"),
    ];

    /// <summary>
    /// A seam reads on only when it actually works: risk-gate needs both its plugin mounted
    /// (<see cref="HarnessSettings.EnableRiskGate"/>) and the seam listed, so the toggle never
    /// shows a state the boot would not honour.
    /// </summary>
    private bool SeamOn(string key)
        => key == "risk-gate" && !_settings.EnableRiskGate ? false : SeamListed(key);

    private bool SeamListed(string key)
        => _settings.SystemOneSeams.Count == 0
           || _settings.SystemOneSeams.Contains("*")
           || _settings.SystemOneSeams.Contains(key);

    private void SetSeam(string key, bool on)
    {
        // Materialise the implicit "all" default before removing one, so the toggle means what it says.
        if (_settings.SystemOneSeams.Count == 0 || _settings.SystemOneSeams.Contains("*"))
            _settings.SystemOneSeams = [.. DecisionSeams.Select(s => s.Key)];
        if (on)
        {
            if (!_settings.SystemOneSeams.Contains(key)) _settings.SystemOneSeams.Add(key);
            // risk-gate is a double switch (plugin mount + seam); one tick must close both.
            if (key == "risk-gate") _settings.EnableRiskGate = true;
        }
        else
        {
            _settings.SystemOneSeams.Remove(key);
        }
    }
    private string _lastProvider = "";
    private IReadOnlyList<Blazorly.Harness.Llm.LlmModelInfo> _models = [];
    private List<string>? _discovered;
    private string? _discoverError;
    private bool _discovering;
    private CustomProviderConfig? _customModal;
    private bool _isNewCustom;
    private string _customError = "";
    private ProviderInfo? _providerInfo => ProviderCatalog.Info(_settings.Provider);

    /// <summary>Providers that require a key before their API will list models
    /// (cloud routes, plus local servers gated by a key such as Unsloth Studio).</summary>
    private bool NeedsKey => (_providerInfo is { Local: false } or { ApiKeyEnv: not null }) && _settings.Provider != "openai-compatible";

    /// <summary>Keyless streaming is allowed (local servers, custom gateways); set a key only when the server enforces auth.</summary>
    private bool KeyOptional => !ProviderCatalog.RequiresApiKey(_settings.Provider);

    protected override void OnInitialized()
    {
        _settings = Facade.Harness.Settings;
        _lastProvider = _settings.Provider;
        RefreshModels();
    }

    protected override void OnParametersSet()
    {
        _tab = Tabs.Any(t => t.Id == RequestedTab) ? RequestedTab! : "provider";
        // A page load/refresh never fires network: the persisted API list (if any) seeds the
        // dropdown labels below, and discovery only runs on explicit gestures (provider switch,
        // key blur, Load click). Auto-loading here re-fired a hanging custom URL on every
        // refresh and wedged the button on "Loading…" with no way out.
        if (_tab == "provider" && !_providerTabVisited)
        {
            _providerTabVisited = true;
            SeedDiscoveredFromPersisted();
        }
    }

    private void SeedDiscoveredFromPersisted()
    {
        if (_discovered is null
            && Facade.Harness.Settings.DiscoveredModels.TryGetValue(_settings.Provider, out var found)
            && found.Count > 0)
        {
            _discovered = [.. found.Select(m => m.Id)];
        }
    }

    private async Task MaybeAutoDiscoverAsync()
    {
        if (_discovering) return;
        if (NeedsKey && string.IsNullOrWhiteSpace(_settings.ApiKey)
            && string.IsNullOrWhiteSpace(Facade.Harness.Settings.EffectiveApiKey))
        {
            return; // no key yet: keep the placeholder, list nothing
        }
        if (string.IsNullOrWhiteSpace(_settings.BaseUrl)) return; // nothing to call yet
        if (_settings.Provider == "openai-compatible"
            && _settings.BaseUrl.Trim().TrimEnd('/') == (ProviderCatalog.Info("openai-compatible")?.DefaultBaseUrl.TrimEnd('/')))
        {
            return; // untouched example placeholder: wait for the user to type a real endpoint
        }
        await DiscoverModels();
    }

    private async Task ApiKeyBlurred()
    {
        if (string.IsNullOrWhiteSpace(_settings.ApiKey)) return;
        await MaybeAutoDiscoverAsync();
    }

    // Focusing the first field also makes Escape work immediately (keydown lands inside the modal).
    private Microsoft.AspNetCore.Components.ElementReference _modalFirstField;
    private bool _focusModal;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusModal && _customModal is not null)
        {
            _focusModal = false;
            try { await _modalFirstField.FocusAsync(); }
            catch (ObjectDisposedException) { }
        }
    }

    private static string CategoryLabel(string category) => category switch
    {
        "cloud" => "Cloud providers",
        "local" => "Local & self-hosted",
        _ => "Other",
    };

    /// <summary>Records which provider the typed URL belongs to, so a later provider switch does not send it to the wrong host.
    /// The previously loaded list belonged to the old URL, so it clears until Load runs again.</summary>
    private void BaseUrlEdited()
    {
        _settings.BaseUrlProvider = _settings.Provider;
        _discovered = null;
        _models = [];
    }

    private async Task ProviderChanged()
    {
        // Key stashing, base-URL swap and the new provider's default model live in one place so the
        // CLI's --provider override cannot drift from what the UI does.
        _settings.SelectProvider(_lastProvider, _settings.Provider);
        _lastProvider = _settings.Provider;
        _discovered = null;
        _discoverError = null;
        RefreshModels();
        SeedDiscoveredFromPersisted();
        StateHasChanged();
        await MaybeAutoDiscoverAsync();
    }

    private void RefreshModels()
    {
        // The Settings dropdown lists API-loaded models only;
        // the catalog seeds remain the route fallback for the meter and session picker until discovery runs.
        _models = HasApiList ? Facade.Harness.RuntimeModels(_settings.Provider) : [];
        if (_models.Count > 0 && _models.All(m => m.Id != _settings.Model))
        {
            _settings.Model = _models[0].Id;
        }
    }

    private bool HasApiList => Facade.Harness.Settings.DiscoveredModels.TryGetValue(_settings.Provider, out var ids) && ids.Count > 0;

    private System.Threading.CancellationTokenSource? _discoverCts;

    private async Task DiscoverModels()
    {
        // The button disables while a run is in flight; this also swallows a second click
        // that lands before the re-render, so two runs can never share the cancel source.
        if (_discovering) return;
        _discoverCts = new System.Threading.CancellationTokenSource();
        _discovering = true;
        _discoverError = null;
        try
        {
            var (models, error) = await Facade.Harness.DiscoverModelsAsync(
                _settings.Provider, _settings.BaseUrl, _settings.ApiKey, ct: _discoverCts.Token);
            if (error is not null)
            {
                _discoverError = error;
                _discovered = null;
            }
            else
            {
                _discovered = [.. models];
                RefreshModels();
            }
        }
        catch (Exception ex)
        {
            // DiscoverModelsAsync already funnels failures into its error slot; this keeps any
            // unexpected throw off the error UI and the button out of "Loading…" regardless.
            _discoverError = ex.Message;
            _discovered = null;
        }
        finally
        {
            _discovering = false;
            _discoverCts?.Dispose();
            _discoverCts = null;
            if (!_disposed) StateHasChanged();
        }
    }

    private void CancelDiscover()
    {
        try { _discoverCts?.Cancel(); }
        catch (ObjectDisposedException) { }
    }

    private bool _disposed;

    public void Dispose()
    {
        _disposed = true;
        // Navigating away aborts a hung request instead of leaving it to time out.
        try { _discoverCts?.Cancel(); }
        catch (ObjectDisposedException) { }
    }

    private void AddCustomProvider()
    {
        _customModal = new CustomProviderConfig();
        _isNewCustom = true;
        _original = null;
        _customError = "";
        _focusModal = true;
    }

    private void EditCustom(CustomProviderConfig custom)
    {
        // Edit a copy; Apply writes back only on Save.
        _customModal = new CustomProviderConfig
        {
            Name = custom.Name,
            BaseUrl = custom.BaseUrl,
            ApiKey = custom.ApiKey,
            ApiKeyEnv = custom.ApiKeyEnv,
            Models = [.. custom.Models],
        };
        _isNewCustom = false;
        _original = custom;
        _customError = "";
        _focusModal = true;
    }

    private void SaveCustomModal()
    {
        var modal = _customModal!;
        var name = modal.Name.Trim();
        if (name.Length == 0 || modal.BaseUrl.Trim().Length == 0)
        {
            _customError = "name and base URL are required";
            return;
        }
        if (ProviderCatalog.Info(name) is not null ||
            _settings.CustomProviders.Any(c => c != _original && c.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
        {
            _customError = $"'{name}' is already a provider name";
            return;
        }
        if (_original is not null)
        {
            _settings.CustomProviders.Remove(_original);
        }
        modal.Name = name;
        modal.BaseUrl = modal.BaseUrl.Trim();
        _settings.CustomProviders.Add(modal);
        _original = null;
        _customModal = null;
        Facade.Harness.ApplyProviderSelection();
    }

    private void CloseCustomModal()
    {
        _customModal = null;
        _original = null;
        _customError = "";
    }

    private void OnModalKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseCustomModal();
    }

    private void RemoveCustomProvider(CustomProviderConfig custom)
    {
        _settings.CustomProviders.Remove(custom);
        Facade.Harness.ApplyProviderSelection(); // drop the route immediately
        StateHasChanged();
    }

    private string? _customDiscovering;
    private string? _customDiscoverError;

    private async Task DiscoverCustom(CustomProviderConfig custom)
    {
        if (_customDiscovering is not null) return;
        _customDiscovering = custom.Name;
        _customDiscoverError = null;
        try
        {
            // Same GET /models path as the built-ins; the bootstrapper appends new ids to
            // the custom entry, persists settings and rebuilds the route.
            var (_, error) = await Facade.Harness.DiscoverModelsAsync(custom.Name);
            if (error is not null) _customDiscoverError = $"{custom.Name}: {error}";
        }
        catch (Exception ex)
        {
            _customDiscoverError = $"{custom.Name}: {ex.Message}";
        }
        finally
        {
            _customDiscovering = null;
            if (!_disposed) StateHasChanged();
        }
    }

