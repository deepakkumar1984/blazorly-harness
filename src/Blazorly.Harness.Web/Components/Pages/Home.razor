@page "/"
@using Blazorly.Harness.Web.Services
@inject SessionFacade Facade
@inject NavigationManager Navigation

<div class="workspace-welcome">
    <span class="brand-mark">⚡</span>
    @if (Facade.Harness.SettingsLoadError is { } loadError)
    {
        <h1>Settings need attention</h1>
        <p role="alert">@loadError</p>
    }
    else if (Facade.Harness.Llm.ListProviders().Count == 0)
    {
        <h1>Set up your provider</h1>
        <p>No provider is configured. <a href="/settings">Add a provider in Settings</a>, then discover models or enter a model ID.</p>
        <p>Add a workspace folder from the sidebar to start a chat.</p>
    }
    else
    {
        <h1>Open a workspace</h1>
        <p>Add a folder from the sidebar to bring its chats, files, and run commands together.</p>
    }
    @if (Facade.LiveSessions().Any())
    {
        <p>Your existing chats are available in the workspace switcher.</p>
    }
</div>

@code
{
    protected override void OnInitialized()
    {
        // The open workspace is the product surface. Land in its latest chat, not a
        // chat that happens to belong to some other folder.
        Workspace? preferred = null;
        try { preferred = Facade.Harness.Workspaces.Default(); }
        catch (InvalidOperationException) { }

        var chats = Facade.LiveSessions()
            .Where(s => s.Header.ParentSession is null && !Facade.IsArchived(s.Id));
        if (preferred is not null)
        {
            var latest = chats
                .Where(s => Facade.WorkspaceOf(s)?.Id == preferred.Id)
                .OrderBy(s => s.Header.CreatedAt)
                .LastOrDefault();
            if (latest is not null)
            {
                Navigation.NavigateTo($"/session/{latest.Id}");
                return;
            }
            Navigation.NavigateTo($"/session/{Facade.CreateSession(preferred.Id).Id}");
            return;
        }

        // Removing the final workspace leaves a useful empty state. Do not recreate it
        // or attempt to create a session without a registered workspace.
    }
}
