    private void ForkHere() => ForkAt(null);

    private void ForkAt(string? key)
    {
        int? atSeq = null;
        if (key is { Length: > 0 } && key.StartsWith("te-") && int.TryParse(key[3..], out var seq)) atSeq = seq;
        var child = Facade.Fork(SessionId, atSeq);
        Navigation.NavigateTo($"/session/{child.Id}", forceLoad: true);
    }

    private string Preview(SessionEvent e)
    {
        var raw = e.Data.GetRawText();
        return raw.Length > 160 ? raw[..160] + "…" : raw;
    }

    private static string FormatMs(double ms)
        => ms > 1000 ? $"{ms / 1000.0:F1}s" : $"{Math.Round(ms)}ms";

    private (List<(string Label, string Value)> Lines, List<(string Label, string Value)> Tools) SessionStats()
    {
        var lines = new List<(string Label, string Value)>();
        var stats = Facade.Harness.Projections.Stats(_session);

        lines.Add(("turns", stats.Turns == 0 ? "0" : $"{stats.Turns} ({stats.Completed} completed{(stats.Errored > 0 ? $", {stats.Errored} errored" : "")}{(stats.Cancelled > 0 ? $", {stats.Cancelled} cancelled" : "")})"));
        lines.Add(("conversation", FormatMs(stats.ConversationMs)));
        lines.Add(("events", $"{stats.Events:N0}"));
        if (stats.Compactions > 0) lines.Add(("compactions", $"{stats.Compactions}"));
        if (stats.Retries > 0) lines.Add(("llm retries", $"{stats.Retries}"));
        if (Facade.Harness.Meter?.Measure(_agent) is { } reading)
        {
            lines.Add(("context", $"{reading.OccupancyPercent}% of {reading.ContextWindowTokens:N0}"));
            lines.Add(("tokens", $"{reading.TotalInputTokens:N0} in · {reading.TotalOutputTokens:N0} out"
                + $" · cache {reading.TotalCacheReadTokens:N0}/{reading.TotalCacheWriteTokens:N0}"));
        }

        var toolLines = stats.Tools
            .Select(t => (t.Name, $"{t.Count}×"))
            .ToList();
        return (lines, toolLines);
    }

    private static string MeterTooltip(Blazorly.Harness.Core.TokenMeter.ContextMeterReading context)
    {
        var provider = context.ProviderPressureTokens is { } p ? $"{p} tokens (provider-anchored)" : "no provider usage yet";
        return $"context ~{context.OccupancyPercent}% of {context.ContextWindowTokens:N0}"
            + $" — system {context.SystemTokens} · tools {context.ToolsTokens} · messages {context.MessageTokens} tokens"
            + $"; last request {provider}"
            + $"; totals in {context.TotalInputTokens} / out {context.TotalOutputTokens}"
            + $" / cache-read {context.TotalCacheReadTokens} / cache-write {context.TotalCacheWriteTokens}";
    }

    private static string DescribeReason(TurnEndReason? reason) => reason switch
    {
        TurnEndReason.Aborted aborted => aborted.Cause == "user"
            ? "stopped — you pressed Stop"
            : $"stopped ({aborted.Cause})",
        TurnEndReason.Error error => $"failed — {error.Message}",
        TurnEndReason.MaxTokens => "stopped — the model reached its output limit for this turn",
        TurnEndReason.Blocked => "blocked before starting",
        TurnEndReason.Interrupted => "interrupted — the app restarted while this turn was running; send a new message to continue",
        _ => "ended",
    };

    private static char TodoGlyph(string status) => status switch
    {
        TodoItem.Completed => '✔',
        TodoItem.InProgress => '◐',
        _ => '○',
    };

