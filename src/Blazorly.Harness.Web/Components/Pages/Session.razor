        if (e.Key is "Escape") CloseMenus();
    }

    private void TogglePermissionMenu()
    {
        _permissionMenu = !_permissionMenu;
        _modelMenu = false;
        _ctxMenu = false;
    }

    private void ToggleContextMenu()
    {
        _ctxMenu = !_ctxMenu;
        _modelMenu = false;
        _permissionMenu = false;
    }

    private void CloseMenus()
    {
        _restoreModelFocus = _modelMenu;
        _focusModelSearch = false;
        _modelMenu = false;
        _permissionMenu = false;
        _ctxMenu = false;
        _docsOpen = false;
        _runMenu = false;
    }

    private void SelectModel(string provider, string model)
    {
        _draftProvider = provider;
        _draftModel = model;
        NormalizeDraftEffort();
    }

    private void NormalizeDraftEffort()
    {
        if (DraftModelInfo?.EffectiveReasoningEfforts.Contains(_draftEffort, StringComparer.Ordinal) != true)
            _draftEffort = "";
    }

    private void ApplyModelSettings()
    {
        if (_draftProvider.Length == 0 || _draftModel.Length == 0) return;
        NormalizeDraftEffort();
        _agent.Options = _agent.Options with
        {
            Provider = _draftProvider,
            Model = _draftModel,
            ReasoningEffort = _draftEffort.Length == 0 ? null : _draftEffort,
            MaxTokens = HarnessBootstrapper.ResolveMaxOutputTokens(Facade.Harness.Settings,
                Facade.Harness.RuntimeModels(_draftProvider), _draftModel),
        };
        _dirty = true;
        CloseMenus();
    }

    private Task SelectPermission(string mode)
    {
        Facade.SetSessionSandboxMode(SessionId, mode);
        _permissionMenu = false;
        _dirty = true;
        return Task.CompletedTask;
    }

    private void ReloadPage() => Navigation.NavigateTo($"/session/{SessionId}", forceLoad: true);

    private void SwitchView(string view)
    {
        if (view is "chat" or "trajectory") OpenLoadedChat();
        if (view == "code")
        {
            WorkspaceUi.ShowFiles();
            var file = WorkspaceUi.Tabs.LastOrDefault(t => t.RelativePath == WorkspaceUi.ActiveFile)
                ?? WorkspaceUi.Tabs.LastOrDefault(t => !t.IsChat);
            if (file?.RelativePath is { } path && DocsRoot is { } root) WorkspaceUi.OpenFile(root, path);
        }
        _view = view;
        if (view == "chat") { _pendingScroll = true; _pendingScrollForce = false; }
    }

    private void OnWorkspaceUiChanged() => _ = InvokeAsync(() =>
    {
        if (_disposed) return;
        if (_sessionLoading) { StateHasChanged(); return; }
        if (WorkspaceUi.ChatRequest is { } chat && chat.Version != _chatRequestVersion && chat.SessionId == _loadedSessionId)
        {
            _chatRequestVersion = chat.Version;
            OpenLoadedChat();
        }
        ApplyRequestedFile();
        if (_tabSelectionVersion != WorkspaceUi.SelectionVersion)
        {
            _tabSelectionVersion = WorkspaceUi.SelectionVersion;
            if (WorkspaceUi.ActiveTab is { SessionId: { } id })
            {
                if (id == _loadedSessionId)
                {
                    _view = "chat";
                    _pendingScroll = true;
                }
                else Navigation.NavigateTo($"/session/{id}");
            }
            else _view = WorkspaceUi.ActiveTab is null ? "empty" : "code";
        }
        StateHasChanged();
    });

    private void OpenLoadedChat()
    {
        if (_session is null || _sessionLoading) return;
        WorkspaceUi.OpenChat(DocsRoot, _session.Id, SessionFacade.DeriveTitle(_session));
        _tabSelectionVersion = WorkspaceUi.SelectionVersion;
        _view = "chat";
    }

    private void ActivateWorkspaceTab(WorkspaceTab tab)
    {
        if (tab.SessionId is { } id)
        {
            WorkspaceUi.RequestChat(id);
            if (id != _loadedSessionId) Navigation.NavigateTo($"/session/{id}");
        }
        else if (tab.RelativePath is { } path && DocsRoot is { } root) WorkspaceUi.OpenFile(root, path);
    }

    private async Task CloseWorkspaceTab(WorkspaceTab tab)
    {
        if (tab.IsChat) WorkspaceUi.CloseTab(tab.Key);
        else if (_codeWorkspace is not null && tab.RelativePath is { } path) await _codeWorkspace.AskCloseTab(path);
    }

    private async Task CloseAllWorkspaceTabs()
    {
        if (_codeWorkspace is not null) await _codeWorkspace.AskCloseAll();
        else WorkspaceUi.CloseAllTabs();
    }

    private bool ApplyRequestedFile()
    {
        if (WorkspaceUi.FileRequest is not { } request || request.Version == _fileRequestVersion
            || !WorkspaceFiles.SameRoot(request.Root, DocsRoot)) return false;
        _fileRequestVersion = request.Version;
        _view = "code";
        return true;
    }

    private Task CopyNode(ConversationNode node)
    {
        var text = string.Join("\n", (node.Blocks ?? []).OfType<TextBlock>().Select(b => b.Text));
        _copiedKey = node.Key;
        _copyFlash?.Stop();
        _copyFlash?.Start();
        return CopyText(text);
    }

    private string TabClass(string view) => _view == view ? "tab active" : "tab";

    private async Task CopyText(string text)
    {
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    private void Answer(string id, string answer)
    {
        Interactions.TryAnswer(id, answer);
        _pendingChanged = true;
    }

    // ---- multi-question ask: answers draft locally and submit as one payload ---------------
    // ("id=text\u0001id=text…") so an N-question ask resolves atomically. Clicking an option
    // used to complete the whole interaction with a single answer, dropping the rest.
    private readonly Dictionary<string, string> _questionAnswers = new(StringComparer.Ordinal);

    private IReadOnlyList<string> Selections(Blazorly.Harness.Core.AskQuestion question)
        => _questionAnswers.TryGetValue(question.Id, out var value) && value.Length > 0
            ? value.Split('\u0001').ToList()
            : [];

    private bool IsSelected(Blazorly.Harness.Core.AskQuestion question, string label)
        => Selections(question).Contains(label);

    private void ToggleAnswer(Blazorly.Harness.Core.AskQuestion question, string label)
    {
        var current = Selections(question);
        List<string> next;
        if (question.MultiSelect)
        {
            next = current.Contains(label) ? [.. current.Where(v => v != label)] : [.. current, label];
        }
        else
        {
            next = current.Count == 1 && current[0] == label ? [] : [label];
        }
        if (next.Count == 0) _questionAnswers.Remove(question.Id);
        else _questionAnswers[question.Id] = string.Join('\u0001', next);
    }

    private string FreeText(Blazorly.Harness.Core.AskQuestion question)
        => _questionAnswers.TryGetValue(question.Id, out var value) ? value : "";

    private void SetFreeText(Blazorly.Harness.Core.AskQuestion question, string text)
        => _questionAnswers[question.Id] = text;

    private int AnsweredCount(IReadOnlyList<Blazorly.Harness.Core.AskQuestion> questions)
        => questions.Count(q => Selections(q).Count > 0);

    private void SubmitAnswers()
    {
        if (_pendingQuestion is not { } pending) return;
        var parts = (pending.Questions ?? [])
            .SelectMany(q => Selections(q).Select(value => $"{q.Id}={value}"))
            .ToList();
        if (parts.Count == 0) return;
        Interactions.TryAnswer(pending.Id, string.Join('\u0001', parts));
        _questionAnswers.Clear();
        _pendingChanged = true;
    }

    private bool HasModelRoute => !string.IsNullOrWhiteSpace(_agent?.Options.Provider)
        && !string.IsNullOrWhiteSpace(_agent?.Options.Model)
        && Facade.Harness.Llm.ListProviders().Contains(_agent.Options.Provider, StringComparer.Ordinal);

    private bool CanSend => !_sessionLoading && _loadError is null
        && (HasModelRoute || _draft.TrimStart().StartsWith('/'))
        && (_draft.Trim().Length > 0 || _pendingFiles.Count > 0);

    private bool CanFork => !_running && _session?.LatestTurnEndSeq() is not null;

    private void OpenDocsModal()
    {
        if (DocsRoot is null) return;
        _modelMenu = false;
        _permissionMenu = false;
        _ctxMenu = false;
        _docsResult = null;
        _docsOpen = true;
        RefreshDocsPreview();
    }

    private void RefreshDocsPreview()
    {
        _docsResult = null;
        try
        {
            _docsPreview = Facade.PreviewSessionDocs(SessionId, _docsDepth);
        }
        catch (Exception ex)
        {
            _docsPreview = null;
            _docsResult = $"Preview failed: {ex.Message}";
        }
    }

    private async Task ApplyDocsInit()
    {
        if (DocsRoot is null || _docsGenerating) return;
        var provider = _agent?.Options.Provider;
        var model = _agent?.Options.Model;
        if (string.IsNullOrWhiteSpace(provider) || string.IsNullOrWhiteSpace(model))
        {
            _docsResult = "Pick a provider and model first (model menu above) — drafting is AI-generated.";
            return;
        }
        _docsGenerating = true;
        _docsResult = $"Drafting with {provider}/{model}…";
        try
        {
            var result = await Facade.GenerateSessionDocsAsync(
                SessionId, _docsDepth, provider, model, _agent?.Options.ReasoningEffort);
            _docsResult = result.Written.Count == 0
                ? "Everything is already up to date."
                : $"Wrote {result.Written.Count} file(s) with {result.Model}: {string.Join(", ", result.Written)}";
            if (result.Unresolved.Count > 0)
                _docsResult += $" Warning: {result.Unresolved.Count} invented path(s) survived correction: " +
                    string.Join(", ", result.Unresolved.Take(5).Select(u => u.Reference));
            _docsPreview = Facade.PreviewSessionDocs(SessionId, _docsDepth);
        }
        catch (Exception ex)
        {
            _docsResult = $"Generate failed: {ex.Message}";
        }
        finally
        {
            _docsGenerating = false;
        }
    }

    private void ForkHere()
    {
        // Honor the tooltip: branch at the last settled turn, never the live tip
        // (a tip cut inside an open turn is what used to crash the circuit).
        if (!CanFork || _session?.LatestTurnEndSeq() is not { } boundary) return;
        var child = Facade.Fork(SessionId, boundary);
        Navigation.NavigateTo($"/session/{child.Id}", forceLoad: true);
    }

    private void ForkAt(string? key)
    {
        int? atSeq = null;
        if (key is { Length: > 0 } && key.StartsWith("te-") && int.TryParse(key[3..], out var seq)) atSeq = seq;
        var child = Facade.Fork(SessionId, atSeq);
        Navigation.NavigateTo($"/session/{child.Id}", forceLoad: true);
    }

    private static string FormatMs(double ms)
        => ms > 1000 ? $"{ms / 1000.0:F1}s" : $"{Math.Round(ms)}ms";

    private (List<(string Label, string Value)> Lines, List<(string Label, string Value)> Tools) SessionStats()
    {
        var lines = new List<(string Label, string Value)>();
        var stats = Facade.Harness.Projections.Stats(_session);

        lines.Add(("turns", stats.Turns == 0 ? "0" : $"{stats.Turns} ({stats.Completed} completed{(stats.Errored > 0 ? $", {stats.Errored} errored" : "")}{(stats.Cancelled > 0 ? $", {stats.Cancelled} cancelled" : "")})"));
        lines.Add(("conversation", FormatMs(stats.ConversationMs)));
        lines.Add(("events", $"{stats.Events:N0}"));
        if (stats.Compactions > 0) lines.Add(("compactions", $"{stats.Compactions}"));
        if (stats.Retries > 0) lines.Add(("llm retries", $"{stats.Retries}"));
        if (Facade.Harness.Meter?.Measure(_agent) is { } reading)
        {
            lines.Add(("context", $"{reading.OccupancyPercent}% of {reading.ContextWindowTokens:N0}"));
            lines.Add(("tokens", $"{reading.TotalInputTokens:N0} in · {reading.TotalOutputTokens:N0} out"
                + $" · cache {reading.TotalCacheReadTokens:N0}/{reading.TotalCacheWriteTokens:N0}"));
        }

        var toolLines = stats.Tools
            .Select(t => (t.Name, $"{t.Count}×"))
            .ToList();
        return (lines, toolLines);
    }

    /// <summary>Thousands-separated token count for the context card rows.</summary>
    private static string Fmt(long tokens) => tokens.ToString("N0");

    /// <summary>Meter tone by occupancy: warn from the compaction threshold (72%), danger near-full.</summary>
    private static string MeterTone(int occupancyPercent) => occupancyPercent switch
    {
        >= 90 => "hot",
        >= 72 => "warm",
        _ => "",
    };

    private static string DescribeReason(TurnEndReason? reason) => reason switch
    {
        TurnEndReason.Aborted aborted => aborted.Cause == "user"
            ? "stopped — you pressed Stop"
            : $"stopped ({aborted.Cause})",
        TurnEndReason.Error error => $"failed — {error.Message}",
        TurnEndReason.MaxTokens => "stopped — the model reached its output limit for this turn",
        TurnEndReason.Blocked => "blocked before starting",
        TurnEndReason.Interrupted => "interrupted — the app restarted while this turn was running; send a new message to continue",
        _ => "ended",
    };

    private static char TodoGlyph(string status) => status switch
    {
        TodoItem.Completed => '✔',
        TodoItem.InProgress => '◐',
        _ => '○',
    };

    private static char DelegationGlyph(string status) => status switch
    {
        "running" => '◐',
        "finished" => '✔',
        "error" => '✕',
        _ => '⊘',
    };

