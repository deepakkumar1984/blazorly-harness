    private string _draftEffort = "";
    private LlmModelInfo? DraftModelInfo => Facade.Harness.RuntimeModels(_draftProvider).FirstOrDefault(m => m.Id == _draftModel);
    private ElementReference _composerTa;
    private ElementReference _slashMenu;
    private ElementReference _mentionMenu;
    private Microsoft.JSInterop.DotNetObjectReference<Session>? _slashRef;
    private bool _editingTitle;
    private string _titleDraft = "";
    private Llm.Message? _editingQueue;
    private string _queueDraft = "";
    private ElementReference _transcript;
    private IDisposable? _subscription;
    private System.Timers.Timer? _coalesce;
    private PendingInteraction? _pendingApproval;
    private PendingInteraction? _pendingQuestion;
    private bool _rawTrajectory;
    private int _rawPageIndex;
    private RawTrajectoryPage _rawEvents = new();
    private bool _statsOpen;
    private bool _todosCollapsed;
    private bool _delegationsCollapsed;
    private string? _copiedKey;
    private System.Timers.Timer? _copyFlash;

    // ---- pending file attachments (paste, drop, or the paperclip button) ----
    private readonly List<(string Id, string FileName, string Kind)> _pendingFiles = [];
    private ElementReference _clipInput;
    private Microsoft.JSInterop.DotNetObjectReference<Session>? _imageRef;

    private bool ShowTodos => _view == "chat" && !_todosCollapsed && (_snapshot?.Todos.Count ?? 0) > 0;

    /// <summary>Delegated agents (subagents, teammates, swarm workers) run inside THIS chat:
    /// their live progress folds into a side panel, and their sessions stay out of the sidebar.</summary>
    private bool ShowDelegations => _view == "chat" && !_delegationsCollapsed && (_snapshot?.Delegations.Count ?? 0) > 0;

    // ---- ui terminal state ----
    private bool DockOpen => _terminalOpen || _runOpen;
    private int RunningCount => _runs.Count(r => r.Running);
    private RunSnapshot? SelectedRun => _runs.FirstOrDefault(r => r.Id == _selectedRunId) ?? _runs.FirstOrDefault();

    private bool _runMenu;
    private bool _disposed;
    private long _fileRequestVersion;
    private long _chatRequestVersion;
    private long _tabSelectionVersion;
    private CodeWorkspace? _codeWorkspace;
    private readonly Dictionary<string, (string Text, (string Id, string FileName, string Kind)[] Files)> _chatDrafts = new();
    private bool _runOpen;
    private string _dockTab = "terminal";
    private string? _runError;
    private string? _selectedRunId;
    private List<ProjectCommand> _runTargets = [];
    private List<RunSnapshot> _runs = [];
    private System.Timers.Timer? _runPoll;

    private bool _terminalOpen;
    private string? _terminalId;
    private string _terminalOutput = "";
    private string _terminalInput = "";
    private bool _terminalDead;
    private System.Timers.Timer? _terminalPoll;
    private ElementReference _terminalOut;
    private ElementReference _runOut;
    private ElementReference _terminalResizeHandle;
    private ElementReference _terminalDrawer;
    private bool _terminalResizeAttached;
    private readonly List<string> _terminalHistory = [];
    private int _terminalHistoryAt;

    [Inject] private MarkdownService Markdown { get; set; } = null!;
    [Inject] private IJSRuntime Js { get; set; } = null!;
    [Inject] private Microsoft.AspNetCore.Components.NavigationManager Navigation { get; set; } = null!;

    private string EffectiveSandbox => Facade.Harness.Sandbox.ResolveMode(_snapshot?.SandboxMode);

    /// <summary>True when commands run unconfined because this host has no Landlock and no preset was chosen.</summary>
    private bool SandboxDegraded => _snapshot?.SandboxMode is null
        && !SandboxPolicy.ConfinementSupported
        && Facade.Harness.Sandbox.ResolveProcessMode(null) == SandboxPolicy.DangerFullAccess
        && EffectiveSandbox != SandboxPolicy.DangerFullAccess;

    private string SandboxTitle => SandboxDegraded
        ? $"'{EffectiveSandbox}' cannot confine spawned commands on this host (no Linux Landlock); bash/run_code execute unconfined while file writes stay inside the workspace. Pick a preset to override — read-only/workspace-write fail closed for commands here."
        : "Switch permission preset (/permission)";
    private string WorkspaceLabel => _session is not null && Facade.WorkspaceOf(_session) is { } ws ? ws.Name : "Unfiled";
    private string Placeholder => _running
        ? "Queue for the next turn (⏎) or type and hit Steer…"
        : "Describe a task… paste or drop files, @reference paths, or type / for commands";

    private string? _loadedSessionId;
    private string? _boundComposerSessionId;
    private bool _sessionLoading;
    private long _sessionLoadVersion;
    private bool _pendingScroll;
    private bool _pendingScrollForce;
    private int? _lastSurfacedFailedTurn;
    private const int TranscriptInitialTake = 200;
    private const int TranscriptGrowTake = 100;
    private int _transcriptTake = TranscriptInitialTake;
    private Microsoft.JSInterop.DotNetObjectReference<Session>? _topGrowRef;

    private IReadOnlyList<ConversationNode> TranscriptWindow =>
        _snapshot is null ? [] : [.. _snapshot.Nodes.TakeLast(_transcriptTake)];

    private int TranscriptHiddenCount =>
        _snapshot is null ? 0 : Math.Max(0, _snapshot.Nodes.Count - TranscriptWindow.Count);

    [JSInvokable]
    public Task<bool> GrowTranscriptTop()
    {
        if (TranscriptHiddenCount == 0) return Task.FromResult(false);
        _transcriptTake = Math.Min(_snapshot!.Nodes.Count, _transcriptTake + TranscriptGrowTake);
        StateHasChanged();
        return Task.FromResult(true);
    }

    private void GrowTranscriptTopUi() => _ = GrowTranscriptTop();
    private Blazorly.Harness.Web.Services.ConversationFolder? _folder;

    protected override Task OnInitializedAsync()
    {
        WorkspaceUi.Changed += OnWorkspaceUiChanged;
        _coalesce = new System.Timers.Timer(120);
        _coalesce.Elapsed += (_, _) =>
        {
            // Heartbeat: while a turn runs, re-render once a second even without new events
            // so live elapsed labels (thinking placeholder) keep ticking.
            var beat = _running && !_dirty && !_pendingChanged
                && DateTimeOffset.UtcNow - _lastBeat >= TimeSpan.FromSeconds(1);
            if (!_dirty && !_pendingChanged && !beat) return;
            _dirty = false;
            _pendingChanged = false;
            if (beat) _lastBeat = DateTimeOffset.UtcNow;
            _ = InvokeAsync(async () =>
            {
                try
                {
                    _snapshot = _folder?.Update(_agent) ?? Assembler.Fold(_session, _agent);
                    _running = _agent.Status == "running";
                    var hadPending = _pendingApproval is not null || _pendingQuestion is not null;
                    RefreshPending();
                    var hasNewPending = (_pendingApproval is not null || _pendingQuestion is not null) && !hadPending;
                    StateHasChanged();
                    if (_pinned && _view == "chat")
                    {
                        // Defer past the render: scrolling here would measure the
                        // pre-render DOM and land above the new bottom. The pending
                        // path in OnAfterRenderAsync scrolls once the DOM is current.
                        // New approval/question popups and newly failed turns force;
                        // steady streaming keeps the near-bottom check so scrolled-up
                        // readers are not yanked.
                        var failedTurn = _session is null ? null : ConversationAssembler.LatestFailedTurn(_session);
                        var hasNewFailure = failedTurn is { } failed && failed != _lastSurfacedFailedTurn;
                        if (failedTurn is { } surfaced) _lastSurfacedFailedTurn = surfaced;
                        _pendingScroll = true;
                        _pendingScrollForce = hasNewPending || hasNewFailure;
                    }
                }
                catch (Exception ex) when (ex is not TaskCanceledException)
                {
                    Console.Error.WriteLine($"[ui] fold failed for {SessionId}: {ex}");
                }
            });
        };
        _coalesce.AutoReset = true;
        _coalesce.Enabled = true;
        // One-shot flash: the copy icon ticks to a check mark, then reverts.
        _copyFlash = new System.Timers.Timer(1100) { AutoReset = false };
        _copyFlash.Elapsed += (_, _) => _ = InvokeAsync(() => { _copiedKey = null; StateHasChanged(); });
        return LoadSessionAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Sidebar navigation between two sessions reuses this component instance and only
        // changes the SessionId parameter — OnInitialized does not run again.
        if (_loadedSessionId == SessionId) return;
        await LoadSessionAsync();
    }

    private async Task LoadSessionAsync()
    {
        if (!_sessionLoading && _loadedSessionId is { } previous)
            _chatDrafts[previous] = (_draft, _pendingFiles.ToArray());
        _sessionLoading = true;
        var loadVersion = ++_sessionLoadVersion;
        _loadedSessionId = SessionId;
        var sessionId = SessionId;
        _subscription?.Dispose();
        _subscription = null;
        _loadError = null;
        _sessionMissing = false;
        try
        {
            var session = await Facade.OpenSessionAsync(sessionId);
            if (_disposed || loadVersion != _sessionLoadVersion) return;
            _session = session;
            _agent = Facade.EnsureAgent(_session);
        }
        catch (Blazorly.Harness.Kernel.HarnessException ex) when (ex.Code == "SESSION_NOT_FOUND")
        {
            if (_disposed || loadVersion != _sessionLoadVersion) return;
            _sessionLoading = false;
            _session = null;
            _agent = null;
            _snapshot = null;
            _sessionMissing = true;
            _loadError = $"Session not found: {sessionId} no longer exists on this machine.";
            Console.Error.WriteLine($"[ui] LoadSessionAsync: session {sessionId} not found on disk; showing fallback UI");
            StateHasChanged();
            return;
        }
        catch (Exception ex)
        {
            if (_disposed || loadVersion != _sessionLoadVersion) return;
            _sessionLoading = false;
            _session = null;
            _agent = null;
            _snapshot = null;
            _loadError = $"Failed to load session: {ex.Message}";
            Console.Error.WriteLine($"[ui] LoadSessionAsync failed for {sessionId}: {ex}");
            StateHasChanged();
            return;
        }
        _sessionLoading = false;
        _folder = Assembler.CreateFolder(_session);
        if (Facade.WorkspaceOf(_session) is { } workspace && Facade.Harness.Workspaces.Default().Id != workspace.Id)
            Facade.Harness.Workspaces.SetDefault(workspace.Id);
        OpenLoadedChat();
        ApplyRequestedFile();
        _snapshot = _folder.Update(_agent);
        _running = _agent.Status == "running";
        _draft = _chatDrafts.TryGetValue(sessionId, out var savedDraft) ? savedDraft.Text : "";
        _modelMenu = false;
        _permissionMenu = false;
        _ctxMenu = false;
        _editingTitle = false;
        _editingQueue = null;
        _statsOpen = false;
        _todosCollapsed = false;
        _rawTrajectory = false;
        _rawPageIndex = 0;
        _rawEvents = new RawTrajectoryPage();
        _pendingApproval = null;
        _pendingQuestion = null;
        _pendingFiles.Clear();
        if (savedDraft.Files is not null) _pendingFiles.AddRange(savedDraft.Files);
        _transcriptTake = TranscriptInitialTake;
        _lastSurfacedFailedTurn = _session is null ? null : ConversationAssembler.LatestFailedTurn(_session);
        _dirty = false;
        // The drawer is per-session: stop polling the previous shell and reset the view
        // (the shell itself stays alive in the service and is re-attached on reopen).
        _terminalOpen = false;
        _terminalPoll?.Stop();
        _terminalId = null;
        _terminalOutput = "";
        _terminalInput = "";
        _terminalDead = false;
        _terminalHistory.Clear();
        _terminalHistoryAt = 0;
        _runMenu = false;
        _runOpen = false;
        _dockTab = "terminal";
        _selectedRunId = null;
        _runs = [];
        SyncRuns();
        EnsureRunPoll();

        _subscription = Broker.Subscribe(frame =>
        {
            if (frame.SessionId != sessionId) return Task.CompletedTask;
            if (frame.Event.Type.StartsWith("ui/"))
            {
                InvokeAsync(() =>
                {
                    var hadPending = _pendingApproval is not null || _pendingQuestion is not null;
                    RefreshPending();
                    var hasNewPending = (_pendingApproval is not null || _pendingQuestion is not null) && !hadPending;
                    StateHasChanged();
                    if (hasNewPending && _pinned && _view == "chat") { _pendingScroll = true; _pendingScrollForce = true; }
                });
                return Task.CompletedTask;
            }
            _dirty = true;
            return Task.CompletedTask;
        });

        RefreshPending();
        _pendingScroll = true;
        _pendingScrollForce = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _slashRef = Microsoft.JSInterop.DotNetObjectReference.Create(this);
            await TryJs("blazorly.slash.attach", _composerTa, _slashMenu,
                SlashCommands.Select(c => new { name = c.Name, args = c.Args, description = c.Description }),
                _slashRef);
            _topGrowRef = Microsoft.JSInterop.DotNetObjectReference.Create(this);
            await TryJs("blazorly.attachTopGrow", _transcript, _topGrowRef);
            await TryJs("blazorly.composer.attach", _composerTa);
            _imageRef = Microsoft.JSInterop.DotNetObjectReference.Create(this);
            // Phones: keep the transcript as the primary surface. Tasks stay one tap away.
            try
            {
                var width = await Js.InvokeAsync<int>("blazorly.viewportWidth");
                if (width > 0 && width <= 760 && !_todosCollapsed)
                {
                    _todosCollapsed = true;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
        if (!_sessionLoading && _loadError is null && _loadedSessionId is { } composerSession
            && _boundComposerSessionId != composerSession)
        {
            _boundComposerSessionId = composerSession;
            await TryJs("blazorly.mention.attach", _composerTa, _mentionMenu, composerSession);
            await TryJs("blazorly.composer.attachImagePaste", _composerTa, _imageRef, _clipInput, composerSession);
        }
        if (_pendingScroll)
        {
            _pendingScroll = false;
            if (_pendingScrollForce) await TryJs("blazorly.settleBottom", _transcript);
            else await ScrollToBottom();
        }
        if (_view == "chat" && _topGrowRef is not null)
            await TryJs("blazorly.attachTopGrow", _transcript, _topGrowRef);

        // Programmatic draft changes (send clears it, slash completion fills it) fire
        // no DOM input event — re-measure so the composer height tracks the text.
        await TryJs("blazorly.composer.grow", _composerTa);
        if (_permissionMenu || _ctxMenu || _runMenu)
        {
            // keep an open dropdown inside the viewport (chips near the right edge on
            // narrow screens would otherwise push the menu off-screen)
            await TryJs("blazorly.clampMenu");
        }
        if (_focusModelSearch && _modelMenu)
        {
            _focusModelSearch = false;
            await TryJs("blazorly.trapModalFocus", _modelDialog);
            try { await _modelSearchInput.FocusAsync(); }
            catch (ObjectDisposedException) { }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
        if (_restoreModelFocus)
        {
            _restoreModelFocus = false;
            try { await _modelTrigger.FocusAsync(); }
            catch (ObjectDisposedException) { }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
        }
        if (DockOpen && !_terminalResizeAttached)
        {
            _terminalResizeAttached = true;
            await TryJs("blazorly.attachTerminalResize", _terminalResizeHandle, _terminalDrawer,
                160 /* min px */, 640 /* max px */, true);
        }
        if (!DockOpen) _terminalResizeAttached = false;
    }

    /// <summary>
    /// JS interop must never tear down the circuit. Hot reload applies Razor without
    /// reloading wwwroot/app.js, so identifiers can be missing until a full refresh.
    /// </summary>
    private async Task<bool> TryJs(string identifier, params object?[] args)
    {
        try
        {
            await Js.InvokeVoidAsync(identifier, args);
            return true;
        }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
        catch (JSException) { }
        catch (TaskCanceledException) { }
        catch (OperationCanceledException) { }
        return false;
    }

    private volatile bool _pendingChanged;

    private void RefreshPending()
    {
        var approval = Interactions.Pending.FirstOrDefault(p => p.Kind == "approval" && p.SessionId == SessionId);
        var question = Interactions.Pending.FirstOrDefault(p => p.Kind == "question");
        if (!ReferenceEquals(approval, _pendingApproval) || !ReferenceEquals(question, _pendingQuestion))
        {
            _pendingApproval = approval;
            _pendingQuestion = question;
            _questionAnswers.Clear();
            _pendingChanged = true;
        }
    }

    private Task ScrollToBottom(bool force = false)
        => TryJs("blazorly.scrollBottom", _transcript, force);

    private Task DraftChanged()
    {
        return Task.CompletedTask;
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !args.ShiftKey)
        {
            // Enter always queues (dsh default); steering is the explicit button while running.
            // The JS menus get first claim on Enter while open (pick vs send).
            try
            {
                var menu = await Js.InvokeAsync<SlashMenuState>("blazorly.slash.state");
                if (menu.Open)
                {
                    if (menu.ArgsEmpty) SubmitSlash(menu.Name);
                    else await CompleteSlash(menu.Name + " ");
                    return;
                }
                var mention = await Js.InvokeAsync<MentionMenuState>("blazorly.mention.state");
                if (mention.Open)
                {
                    await Js.InvokeVoidAsync("blazorly.mention.pick");
                    return;
                }
            }
            catch (JSDisconnectedException) { }
            catch (ObjectDisposedException) { }
            catch (JSException) { }
            await SendQueue();
        }
    }

    private async Task SendQueue()
    {
        if (_sessionLoading || _loadError is not null) return;
        var text = _draft.Trim();
        if (text.Length == 0 && _pendingFiles.Count == 0) return;
        if (text.StartsWith('/'))
        {
            _draft = "";
            _pendingFiles.Clear();
            Facade.TryCommand(SessionId, text);
        }
        else
        {
            if (!HasModelRoute) return;
            _draft = "";
            var ids = _pendingFiles.Select(f => f.Id).ToArray();
            _pendingFiles.Clear();
            await Facade.PromptAsync(SessionId, text.Length > 0 ? text : "Attached.", "queue", ids.Length > 0 ? ids : null);
        }
        _dirty = true;
    }

    private async Task SendSteer()
    {
        if (_sessionLoading || _loadError is not null || !HasModelRoute) return;
        var text = _draft.Trim();
        if (text.Length == 0 && _pendingFiles.Count == 0) return;
        _draft = "";
        var ids = _pendingFiles.Select(f => f.Id).ToArray();
        _pendingFiles.Clear();
        await Facade.PromptAsync(SessionId, text.Length > 0 ? text : "Attached.", "steer", ids.Length > 0 ? ids : null);
        _dirty = true;
    }

