    /// <summary>Called from JS after a paste/drop/paperclip file has been uploaded over
    /// HTTP. Only the resulting id/name/kind strings cross the circuit — the bytes went
    /// through the REST endpoint, because interop messages cap at 32KB.</summary>
    [JSInvokable]
    public Task OnFileUploaded(string sessionId, string id, string fileName, string kind)
    {
        if (_disposed) return Task.CompletedTask;
        if (!_sessionLoading && sessionId == _loadedSessionId)
            _pendingFiles.Add((id, fileName, kind));
        else
        {
            // Uploads may finish after the user selects another chat. Keep each
            // attachment with the session that owned the upload when it started.
            _chatDrafts.TryGetValue(sessionId, out var draft);
            _chatDrafts[sessionId] = (draft.Text ?? "", [.. draft.Files ?? [], (id, fileName, kind)]);
        }
        return InvokeAsync(StateHasChanged);
    }

