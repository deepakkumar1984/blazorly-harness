    private void SyncRuns()
    {
        _runs = DocsRoot is null ? [] : [.. Runs.ForRoot(DocsRoot)];
        if (_selectedRunId is null || _runs.All(r => r.Id != _selectedRunId))
            _selectedRunId = _runs.FirstOrDefault()?.Id;
    }

    private void EnsureRunPoll()
    {
        if (_runPoll is not null)
        {
            _runPoll.Start();
            return;
        }
        _runPoll = new System.Timers.Timer(750);
        _runPoll.Elapsed += (_, _) => _ = InvokeAsync(RunPollAsync);
        _runPoll.Start();
    }

    /// <summary>Run-tab tick: refresh the list and follow the selected run's tail.</summary>
    private async Task RunPollAsync()
    {
        if (_disposed) return;
        try
        {
            var before = SelectedRun?.Output;
            var previousSelection = _selectedRunId;
            var wasRunning = _runs.Count(r => r.Running);
            var previousCount = _runs.Count;
            var previousExit = SelectedRun?.ExitCode;
            SyncRuns();
            var running = _runs.Count(r => r.Running);
            var outputChanged = DockOpen && _dockTab == "run" && SelectedRun?.Output != before;
            if (running != wasRunning || previousCount != _runs.Count || previousExit != SelectedRun?.ExitCode || outputChanged)
                StateHasChanged();
            // Sticky follow: tracks the tail while the user stays at the bottom, respects
            // scrolling up to inspect, and jumps on run switches (fresh content).
            if (outputChanged) await ScrollRunOutput(force: _selectedRunId != previousSelection);
        }
        catch
        {
            // a failed tick must not kill the timer; the next tick retries
        }
    }

    private async Task ToggleTerminal()
    {
        if (_terminalOpen && _dockTab == "terminal")
        {
            CloseDock();
            return;
        }
        _dockTab = "terminal";
        _runOpen = false;
        if (_terminalOpen) return;
        try
        {
            _terminalId = Facade.UiTerminalOpen(SessionId);
            _terminalDead = false;
            _terminalOutput = Facade.UiTerminalRead(SessionId, _terminalId);
            _terminalOpen = true;
            if (_terminalPoll is null)
            {
                _terminalPoll = new System.Timers.Timer(400);
                _terminalPoll.Elapsed += (_, _) => _ = InvokeAsync(TerminalPollAsync);
            }
            _terminalPoll.Start();
            await ScrollTerminal();
        }
        catch (Exception ex)
        {
            _terminalId = null;
            _terminalPoll?.Stop();
            _terminalOutput = OperatingSystem.IsWindows()
                ? "The interactive terminal is not available on Windows yet. Use Run in the header to start and stop project commands."
                : $"Cannot open a shell here: {ex.Message}";
            _terminalOpen = true;
        }
    }

    /// <summary>Picks up streamed output and notices a dead shell; the shell itself lives on.</summary>
    private async Task TerminalPollAsync()
    {
        if (!_terminalOpen || _terminalId is null) return;
        try
        {
            if (!Facade.UiTerminalRunning(SessionId, _terminalId))
            {
                if (!_terminalDead)
                {
                    _terminalDead = true;
                    _terminalOutput += "\n[shell exited — kill shell or close to start a new one]";
                    await InvokeAsync(StateHasChanged);
                }
                return;
            }
            var snapshot = Facade.UiTerminalRead(SessionId, _terminalId);
            if (!ReferenceEquals(snapshot, _terminalOutput) && snapshot != _terminalOutput)
            {
                _terminalOutput = snapshot.Length > 64_000 ? "…\n" + snapshot[^64_000..] : snapshot;
                await InvokeAsync(StateHasChanged);
                await ScrollTerminal();
            }
        }
        catch
        {
            // the shell vanished mid-poll; the next tick reports it
        }
    }

    private void OnTerminalInput(Microsoft.AspNetCore.Components.ChangeEventArgs args)
        => _terminalInput = args.Value?.ToString() ?? "";

    private async Task OnTerminalKey(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            var command = _terminalInput;
            _terminalInput = "";
            if (command.Trim().Length == 0) return;
            _terminalHistory.Add(command);
            if (_terminalHistory.Count > 50) _terminalHistory.RemoveAt(0);
            _terminalHistoryAt = _terminalHistory.Count;
            await TerminalRunAsync(command);
        }
        else if (args.Key == "ArrowUp")
        {
            if (_terminalHistoryAt > 0)
            {
                _terminalHistoryAt--;
                _terminalInput = _terminalHistory[_terminalHistoryAt];
            }
        }
        else if (args.Key == "ArrowDown")
        {
            _terminalHistoryAt = Math.Min(_terminalHistory.Count, _terminalHistoryAt + 1);
            _terminalInput = _terminalHistoryAt < _terminalHistory.Count ? _terminalHistory[_terminalHistoryAt] : "";
        }
    }

    private async Task TerminalRunAsync(string command)
    {
        if (_terminalId is null) return;
        _terminalDead = false;
        try
        {
            await Facade.UiTerminalSendAsync(SessionId, _terminalId, command);
        }
        catch (Exception ex)
        {
            _terminalOutput += $"\n[send failed: {ex.Message}]";
        }
        _terminalOutput = Facade.UiTerminalRead(SessionId, _terminalId);
        if (_terminalOutput.Length > 64_000) _terminalOutput = "…\n" + _terminalOutput[^64_000..];
        await InvokeAsync(StateHasChanged);
        await ScrollTerminal();
    }

    private void TerminalInterrupt()
    {
        if (_terminalId is null) return;
        try { Facade.UiTerminalSignal(SessionId, _terminalId, "SIGINT"); }
        catch (Exception ex) { _terminalOutput += $"\n[signal failed: {ex.Message}]"; }
    }

    private void TerminalClearView()
    {
        if (_terminalId is not null)
        {
            try { Facade.UiTerminalClear(SessionId, _terminalId); }
            catch { /* shell vanished; clearing the view is still right */ }
        }
        _terminalOutput = "";
    }

    private async Task TerminalKillShell()
    {
        if (_terminalId is null) return;
        var dead = _terminalId;
        _terminalId = null;
        _terminalDead = false;
        _terminalOutput = "";
        try { Facade.UiTerminalClose(SessionId, dead); }
        catch { /* already gone */ }
        _terminalId = Facade.UiTerminalOpen(SessionId);
        _terminalOutput = Facade.UiTerminalRead(SessionId, _terminalId);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ScrollTerminal()
    {
        await TryJs("blazorly.scrollBottom", _terminalOut, true);
    }

