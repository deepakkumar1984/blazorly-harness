@page "/session/{SessionId}"
@using Blazorly.Harness.Core.Agent
@using Blazorly.Harness.Core.Sessions
@using Blazorly.Harness.Llm
@using Blazorly.Harness.Tools
@using Blazorly.Harness.Web.Services
@inject SessionFacade Facade
@inject UiEventBroker Broker
@inject UiInteractions Interactions
@inject ConversationAssembler Assembler
@inject RunSupervisor Runs
@inject WorkspaceUiState WorkspaceUi
@implements IDisposable

<div class="session-view @(ShowTodos ? "with-todos" : "") @(ShowDelegations ? "with-delegations" : "") @(DockOpen ? "with-dock" : "")">
    @if (_permissionMenu || _ctxMenu || _runMenu)
    {
        <div class="menu-backdrop" @onclick="CloseMenus"></div>
    }
    <header class="session-header">
        <div class="session-header-row primary">
            <div class="session-identity">
                @if (_editingTitle)
                {
                    <input class="title-edit" value="@_titleDraft" @oninput="OnTitleInput" @onkeydown="OnTitleKey" @onblur="SaveTitle" />
                }
                else
                {
                    <button class="session-title" title="Rename (/title)" @onclick="StartEditTitle">@(_snapshot?.Title is { Length: > 0 } t ? t : _session is not null ? SessionFacade.DeriveTitle(_session) : SessionId)</button>
                }
                <span class="status-chip @(_snapshot?.Status == "running" ? "running" : "idle")" title="Session status">
                    @(_snapshot?.Status == "running" ? "● running" : "○ idle")
                </span>
            </div>
            <div class="session-header-actions">
                <div class="view-tabs" role="tablist" aria-label="Session view">
                    <button class="@TabClass("chat")" role="tab" aria-selected="@(_view == "chat" ? "true" : "false")" aria-label="Chat" data-tip="Chat view" @onclick='() => SwitchView("chat")'>
                        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 3h11v7H9L5.5 13v-3H2.5V3z" /></svg>
                    </button>
                    <button class="@TabClass("trajectory")" role="tab" aria-selected="@(_view == "trajectory" ? "true" : "false")" aria-label="Trajectory" data-tip="Trajectory view" @onclick='() => SwitchView("trajectory")'>
                        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="3.5" cy="12.5" r="1.6" /><circle cx="12.5" cy="3.5" r="1.6" /><path d="M4.9 11.3 8 8.4h3.4V4.6" /></svg>
                    </button>
                    <button class="@TabClass("code")" role="tab" aria-selected="@(_view == "code" ? "true" : "false")" aria-label="Code" data-tip="@(DocsRoot is null ? "No workspace folder for this chat" : "Browse and edit files in this workspace")" @onclick='() => SwitchView("code")' disabled="@(DocsRoot is null)">
                        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5.2 4.2 2.4 8l2.8 3.8" /><path d="M10.8 4.2 13.6 8l-2.8 3.8" /><path d="M9 2.8 7 13.2" /></svg>
                    </button>
                </div>
                <div class="session-toolbar">
                    <div class="chip-anchor">
                        <button class="ghost dock-toggle @(_runMenu || (_runOpen && _dockTab == "run") ? "on" : "")" aria-label="Run" aria-haspopup="menu" data-tip="Run a command detected from this workspace — package.json, dotnet, python, and others" @onclick="ToggleRunMenu" disabled="@(DocsRoot is null)">
                            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.2 2.8v10.4L13 8 4.2 2.8z" /></svg>
                            @if (RunningCount > 0)
                            {
                                <span class="toolbar-count">@RunningCount</span>
                            }
                        </button>
                        @if (_runMenu)
                        {
                            <div class="popover anchored run-menu" role="menu" aria-label="Run commands">
                                <button type="button" class="popover-item" role="menuitem" @onclick="ShowRunPanel">View runs @(_runs.Count > 0 ? $"({_runs.Count})" : "")</button>
                                @if (_runError is { Length: > 0 })
                                {
                                    <div class="popover-empty">@_runError</div>
                                }
                                else if (_runTargets.Count == 0)
                                {
                                    <div class="popover-empty">No package.json, project file, or entry point in this workspace.</div>
                                }
                                else
                                {
                                    @foreach (var group in _runTargets.GroupBy(c => c.Group))
                                    {
                                        <div class="popover-group">@group.Key</div>
                                        @foreach (var command in group)
                                        {
                                            <button type="button" class="popover-item run-item" role="menuitem" @onclick="() => StartRun(command.Id)">
                                                <span>@command.Label</span>
                                                <span class="run-cmd">@command.Detail</span>
                                            </button>
                                        }
                                    }
                                }
                            </div>
                        }
                    </div>
                    <button class="ghost dock-toggle @(_terminalOpen ? "on" : "")" aria-label="Terminal" data-tip="Open the shell dock below the chat" @onclick="ToggleTerminal">
                        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 3.5h11v9h-11z" /><path d="m5 6.2 2.2 2.2L5 10.6" /><path d="M9.3 10.6H12" /></svg>
                    </button>
                    <button class="ghost dock-toggle @(_statsOpen ? "on" : "")" aria-label="Stats" data-tip="Session statistics: turns, tokens, duration, tool usage" @onclick='() => _statsOpen = !_statsOpen'>
                        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 12.5V8" /><path d="M8 12.5V4.5" /><path d="M12.5 12.5V6.5" /><path d="M2.5 13.5h11" /></svg>
                    </button>
                    <button class="ghost" @onclick="ForkHere" aria-label="Fork" disabled="@(!CanFork)"
                            data-tip="@(_running ? "Session is running — forking resumes when the turn settles" : _session?.LatestTurnEndSeq() is null ? "Nothing to fork yet — the first turn has not settled" : "Fork this session at the last completed turn")">
                        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="4.5" cy="3.5" r="1.5" /><circle cx="4.5" cy="12.5" r="1.5" /><circle cx="11.5" cy="8" r="1.5" /><path d="M4.5 5.2v5.6M4.5 8h5.3" /></svg>
                    </button>
                    <button class="ghost" @onclick="OpenDocsModal" aria-label="Generate docs" disabled="@(DocsRoot is null)"
                            data-tip="@(DocsRoot is null ? "No workspace for this session" : "Generate AGENTS.md docs for this workspace with AI — grounded in a repo scan, preview before writing")">
                        <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 1.8h5.5L13 5.3V14.2H4V1.8z" /><path d="M9.3 1.8v3.7H13" /><path d="M6 8.5h4M6 11h4" /></svg>
                    </button>
                    @if (_snapshot?.Todos is { Count: > 0 } toolbarTodos && _view == "chat")
                    {
                        <button class="ghost dock-toggle @(!_todosCollapsed ? "on" : "")"
                                aria-label="Tasks"
                                data-tip="@(_todosCollapsed ? "Show task list" : "Hide task list")"
                                @onclick="() => _todosCollapsed = !_todosCollapsed">
                            <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1.8 7.6l1.7 1.7 3-3.4" /><path d="M6.5 4.5h7" /><path d="M6.5 8h7" /><path d="M6.5 11.5h7" /></svg>
                            <span class="toolbar-count">@toolbarTodos.Count(t => t.Status == TodoItem.Completed)/@toolbarTodos.Count</span>
                        </button>
                    }
                </div>
            </div>
        </div>
        <div class="session-header-row status">
            <div class="session-status">
                <button class="model-chip" title="Configure model and effort" aria-haspopup="dialog" @onclick="ToggleModelMenu" @ref="_modelTrigger">
                    @(HasModelRoute ? $"{_agent?.Options.Provider}/{_agent?.Options.Model}" : "Select a provider and model")
                </button>
                <button class="model-chip" title="Configure reasoning effort" aria-haspopup="dialog" @onclick="ToggleModelMenu">
                    effort: @(_agent?.Options.ReasoningEffort ?? "model default")
                </button>
                <div class="chip-anchor">
                    <button class="status-chip permission" title="@SandboxTitle" @onclick="TogglePermissionMenu">
                        🔒 @(EffectiveSandbox)@(SandboxDegraded ? " ⚠" : "")
                    </button>
                    @if (_permissionMenu)
                    {
                        var confinementAvailable = SandboxPolicy.ConfinementSupported;
                        <div class="popover anchored">
                            <div class="popover-group">permission preset</div>
                            <button class="popover-item @(EffectiveSandbox == SandboxPolicy.ReadOnly ? "selected" : "")" @onclick='() => SelectPermission(SandboxPolicy.ReadOnly)'>
                                read-only
                            </button>
                            <button class="popover-item @(EffectiveSandbox == SandboxPolicy.WorkspaceWrite ? "selected" : "")" @onclick='() => SelectPermission(SandboxPolicy.WorkspaceWrite)'>
                                workspace-write
                            </button>
                            <button class="popover-item @(EffectiveSandbox == SandboxPolicy.FullAccess ? "selected" : "")" @onclick='() => SelectPermission(SandboxPolicy.FullAccess)'>
                                full access
                            </button>
                            @if (!confinementAvailable)
                            {
                                <div class="popover-empty">This host does not have Linux Landlock. Only full access allows bash/run_code.</div>
                            }
                        </div>
                    }
                </div>
                @if (_snapshot?.PlanMode is { } planState)
                {
                    <span class="status-chip" title="Plan mode is active — mutations are blocked until a plan is approved via exit_plan_mode (engaged @(_snapshot.PlanMode == "auto" ? "automatically for a complex brief" : "manually via /plan"))">
                        📋 plan · @(planState == "auto" ? "auto" : "on")
                    </span>
                }
                @if (_snapshot?.Delegations is { Count: > 0 } delegations)
                {
                    var runningCount = delegations.Count(d => d.Status == "running");
                    <button class="status-chip @(runningCount > 0 ? "delegations-active" : "")"
                            title="@(runningCount > 0 ? "Delegated agents are working in this chat — progress in the agents panel" : "Delegated agents ran in this chat — results in the agents panel")"
                            @onclick="() => _delegationsCollapsed = !_delegationsCollapsed">
                        🤖 agents @(runningCount > 0 ? $"{runningCount} running" : $"{delegations.Count} done")
                    </button>
                }
                @if (_snapshot?.Context is { } context)
                {
                    <div class="chip-anchor">
                        <button class="status-chip context-meter" title="Estimated context usage — click for the full reading" @onclick="ToggleContextMenu">
                            <span class="meter"><span class="meter-fill @MeterTone(context.OccupancyPercent)" style="width:@Math.Min(100, context.OccupancyPercent)%"></span></span>
                            ctx ~@context.OccupancyPercent%
                        </button>
                        @if (_ctxMenu)
                        {
                            <div class="popover anchored ctx-card">
                                <div class="popover-group">context window</div>
                                <div class="ctx-meter-lg"><span class="meter-fill @MeterTone(context.OccupancyPercent)" style="width:@Math.Min(100, context.OccupancyPercent)%"></span></div>
                                <div class="ctx-row ctx-head">
                                    <span class="k">estimated use</span>
                                    <span class="v">@Fmt(context.PressureTokens) tokens · @context.OccupancyPercent% of @(context.ContextWindowTokens is { } window ? Fmt(window) : "unknown window")</span>
                                </div>
                                <div class="popover-empty">Estimated from message, system prompt, and tool text. The window uses API/catalog metadata or your configured fallback.</div>
                                <div class="ctx-section">
                                    <div class="ctx-row"><span class="k">system</span><span class="v">@Fmt(context.SystemTokens)</span></div>
                                    <div class="ctx-row"><span class="k">tools</span><span class="v">@Fmt(context.ToolsTokens)</span></div>
                                    <div class="ctx-row"><span class="k">messages</span><span class="v">@Fmt(context.MessageTokens)</span></div>
                                    <div class="ctx-row"><span class="k">provider usage</span><span class="v">@(context.ProviderPressureTokens is { } pressure ? $"{Fmt(pressure)} tokens" : "not reported yet")</span></div>
                                </div>
                                <div class="ctx-section">
                                    <div class="popover-group">session totals</div>
                                    <div class="ctx-row"><span class="k">input</span><span class="v">@Fmt(context.TotalInputTokens)</span></div>
                                    <div class="ctx-row"><span class="k">output</span><span class="v">@Fmt(context.TotalOutputTokens)</span></div>
                                    <div class="ctx-row"><span class="k">cache read</span><span class="v">@Fmt(context.TotalCacheReadTokens)</span></div>
                                    <div class="ctx-row"><span class="k">cache write</span><span class="v">@Fmt(context.TotalCacheWriteTokens)</span></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </header>
    <WorkspaceTabs OnActivate="ActivateWorkspaceTab" OnClose="CloseWorkspaceTab" OnCloseAll="CloseAllWorkspaceTabs" />

    @if (_statsOpen && _session is not null)
    {
        var stats = SessionStats();
        <div class="stats-dock">
            <div class="stats-grid">
                @foreach (var line in stats.Lines)
                {
                    <div class="stats-line"><span class="stats-label">@line.Label</span><span class="stats-value">@line.Value</span></div>
                }
            </div>
            @if (stats.Tools.Count > 0)
            {
                <div class="stats-tools">
                    @foreach (var tool in stats.Tools)
                    {
                        <div class="stats-line"><span class="stats-label">@tool.Label</span><span class="stats-value">@tool.Value</span></div>
                    }
                </div>
            }
        </div>
    }

    <div class="session-body">
    <div class="session-main">
    <CodeWorkspace @ref="_codeWorkspace" Root="@DocsRoot" Visible="@(_view == "code" && _loadError is null)" Request="@WorkspaceUi.FileRequest" />
    @if (_loadError is not null)
    {
        <div class="empty">
            <p style="color:var(--danger);margin-bottom:12px">@_loadError</p>
            <button class="ghost" @onclick="ReloadPage">Retry</button>
            @if (_sessionMissing)
            {
                <p style="margin:12px 0 0;color:var(--muted)">This session no longer exists on disk (its harness home was moved or deleted). Retry will not restore it.</p>
            }
            <a href="/" style="display:inline-block;margin-top:12px">Go to latest session →</a>
        </div>
    }
    else if (_view == "empty")
    {
        <div class="code-placeholder workspace-tabs-empty">
            <h2>@WorkspaceLabel</h2>
            <p>Open a chat or a file from the sidebar. Your chat history stays available there.</p>
            <div class="workspace-empty-actions">
                <button class="ghost" @onclick="WorkspaceUi.ShowChats">Browse chats</button>
                <button class="ghost" @onclick="WorkspaceUi.ShowFiles">Browse files</button>
            </div>
        </div>
    }
    else if (_view == "trajectory" && _session is not null)
    {
        <div class="transcript trajectory">
            <div class="trajectory-head">
                <button class="ghost" @onclick='() => _rawTrajectory = !_rawTrajectory'>@(_rawTrajectory ? "◀ timeline" : "raw events ▶")</button>
            </div>
            @if (_rawTrajectory)
            {
                var total = _session.Seq;
                var lastPage = Math.Max(0, (total - 1) / RawTrajectoryPage.PageSize);
                var rows = _rawEvents.Read(_session, _rawPageIndex);
                <nav class="trajectory-head" aria-label="Raw event pages">
                    <button class="ghost" disabled="@(_rawPageIndex == 0)" @onclick="() => _rawPageIndex = 0">First</button>
                    <button class="ghost" disabled="@(_rawPageIndex == 0)" @onclick="() => _rawPageIndex--">Previous</button>
                    <span role="status">Page @(_rawPageIndex + 1) of @(lastPage + 1) · @total.ToString("N0") events · @RawTrajectoryPage.PageSize per page</span>
                    <button class="ghost" disabled="@(_rawPageIndex >= lastPage)" @onclick="() => _rawPageIndex++">Next</button>
                    <button class="ghost" disabled="@(_rawPageIndex >= lastPage)" @onclick="() => _rawPageIndex = lastPage">Latest</button>
                </nav>
                @if (total == 0)
                {
                    <div class="empty">No events yet.</div>
                }
                else
                {
                    <table class="event-table">
                        <thead><tr><th>seq</th><th>type</th><th>time</th><th>data</th></tr></thead>
                        <tbody>
                            @foreach (var row in rows)
                            {
                                <tr @key="row.Seq">
                                    <td class="mono">@row.Seq</td>
                                    <td class="mono">@row.Type</td>
                                    <td class="mono">@row.Time</td>
                                    <td class="mono preview">@row.Preview</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
            else
            {
                var timeline = TrajectoryBuilder.Build(_session.Events);
                @if (timeline.Preamble.Count > 0)
                {
                    <div class="tl-preamble">
                        @foreach (var row in timeline.Preamble)
                        {
                            <TrajectoryRowView Row="row" />
                        }
                    </div>
                }
                @if (timeline.Turns.Count == 0)
                {
                    <div class="empty">no turns yet — run a prompt to populate the timeline</div>
                }
                @foreach (var turn in timeline.Turns)
                {
                    <div class="tl-turn">
                        <div class="tl-turn-head">
                            <span class="tl-turn-title">turn @turn.Turn</span>
                            <span class="tl-turn-status @turn.Status.Split(' ')[0]">@turn.Status</span>
                            <span class="tl-turn-dur">@FormatMs(turn.DurationMs)</span>
                        </div>
                        <div class="tl-steps">
                            @foreach (var step in turn.Steps)
                            {
                                <div class="tl-step">
                                    @if (turn.Steps.Count > 1 || step.Step > 1)
                                    {
                                        <div class="tl-step-head">step @step.Step</div>
                                    }
                                    @foreach (var row in step.Rows)
                                    {
                                        <TrajectoryRowView Row="row" />
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <div class="transcript" hidden="@(_view != "chat")" @ref="_transcript">
            @if (_snapshot is null)
            {
                <div class="empty">Loading…</div>
            }
            else if (_snapshot.Nodes.Count == 0)
            {
                <div class="hero">
                    <div class="hero-mark">⚡</div>
                    <h1>Blazorly Harness</h1>
                    <p>An agentic coding harness: session-log-first, tool-guarded, fully plugin-composed.</p>
                    <p class="hero-hint">Describe a task below. Type <code>/</code> for commands — <code>/permission</code>, <code>/model</code>, <code>/title</code>.</p>
                </div>
            }
            else
            {
                // Windowed from the tail: only the newest nodes render, so refresh lands
                // instantly at the bottom with no virtualization walk; scrolling up (or the
                // button) prepends older nodes while holding scroll position.
                @if (TranscriptHiddenCount > 0)
                {
                    <button class="transcript-more" @onclick="GrowTranscriptTopUi">
                        Show earlier messages (@TranscriptHiddenCount more)
                    </button>
                }
                @foreach (var node in TranscriptWindow)
                {
                @switch (node.Kind)
                {
                    case "user":
                        <div class="bubble user" data-source="@node.Source" @key="node.Key">
                            <div class="bubble-role">You</div>
                            <div class="bubble-body">@(node.Message?.FlattenText())</div>
                        </div>
                        break;
                    case "assistant":
                        <div class="bubble assistant" @key="node.Key">
                            <div class="bubble-head">
                                <span class="bubble-role">Assistant @(node.StepStatus == "streaming" ? "· typing…" : node.StepStatus == "thinking" ? "· thinking…" : "")</span>
                                @if (node.StepStatus is not ("streaming" or "thinking"))
                                {
                                    <button class="icon-btn bubble-copy @(_copiedKey == node.Key ? "copied" : "")"
                                            title="@(_copiedKey == node.Key ? "Copied" : "Copy message")"
                                            aria-label="Copy message"
                                            @onclick="() => CopyNode(node)">
                                        @if (_copiedKey == node.Key)
                                        {
                                            <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5 6.2 11.5 13 4.8" /></svg>
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.6" /><path d="M10.5 3.2A1.7 1.7 0 0 0 9 2.5H4.2A1.7 1.7 0 0 0 2.5 4.2V9A1.7 1.7 0 0 0 3.2 10.5" /></svg>
                                        }
                                    </button>
                                }
                                @if (node.Usage is { } usage)
                                {
                                    <span class="bubble-meta">@usage.InputTokens in · @usage.OutputTokens out</span>
                                }
                            </div>
                            <div class="bubble-body">
                                @if (node.StepStatus == "thinking" && (node.Blocks is null || node.Blocks.Count == 0))
                                {
                                    <div class="thinking-placeholder">
                                        <span class="thinking-word">waiting for response</span>
                                        @if (node.StartedAt is { } started)
                                        {
                                            <span class="thinking-elapsed">@ConversationNode.ElapsedLabel(started)</span>
                                            @if (DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - started > 30_000)
                                            {
                                                <span class="thinking-note">waiting for the server — this can take a few minutes on long chats</span>
                                            }
                                        }
                                    </div>
                                }
                                else
                                {
                                    @foreach (var block in node.Blocks ?? [])
                                    {
                                        <AssistantBlock Block="block" Markdown="Markdown" StepStatus="node.StepStatus" />
                                    }
                                }
                            </div>
                        </div>
                        break;
                    case "tool":
                        <ToolNode Node="node" @key="node.Key" />
                        break;
                    case "command":
                        <div class="command-row @(node.CommandOk ? "" : "error")" @key="node.Key">
                            <span class="command-name">@node.CommandName @(node.CommandArgs is { Length: > 0 } ? node.CommandArgs : "")</span>
                            <span class="command-text">@node.CommandText</span>
                        </div>
                        break;
                    case "turn-ok":
                        <div class="turn-footer" @key="node.Key">
                            <span>turn @node.Turn complete</span>
                            @if (node.DurationMs is { } ms)
                            {
                                <span class="turn-usage">@(ms > 1000 ? $"{ms / 1000.0:F1}s" : $"{ms}ms")</span>
                            }
                            @if (node.Usage is { } u)
                            {
                                <span class="turn-usage">@u.UsageTokens() tokens</span>
                            }
                            <button class="link" @onclick="() => ForkAt(node.Key)">fork here</button>
                        </div>
                        break;
                    case "turn-end":
                        <div class="turn-error" @key="node.Key">
                            turn @node.Turn ended — @DescribeReason(node.Reason)
                        </div>
                        break;
                }
                }
            }
            @if (_pendingApproval is not null)
            {
                <div class="interaction-card">
                    <div class="interaction-title">Approval requested: <code>@_pendingApproval.ToolName</code></div>
                    @if (_pendingApproval.Reason is { Length: > 0 })
                    {
                        <div class="interaction-body">@_pendingApproval.Reason</div>
                    }
                    <div class="interaction-actions">
                        <button class="primary" @onclick='() => Answer(_pendingApproval.Id, "allowed")'>Allow once</button>
                        <button class="danger" @onclick='() => Answer(_pendingApproval.Id, "rejected")'>Reject</button>
                    </div>
                </div>
            }
            @if (_pendingQuestion is not null)
            {
                var questions = _pendingQuestion.Questions ?? [];
                <div class="interaction-card ask">
                    <div class="interaction-title">
                        @(questions.Count == 1 ? "The assistant has a question" : $"The assistant has {questions.Count} questions")
                        @if (questions.Count > 1)
                        {
                            <span class="ask-progress">@AnsweredCount(questions) of @questions.Count answered</span>
                        }
                    </div>
                    <div class="ask-body">
                        @{ var number = 0; }
                        @foreach (var question in questions)
                        {
                            number++;
                            <div class="question">
                                <div class="question-text">
                                    @if (questions.Count > 1)
                                    {
                                        <span class="question-number">@number</span>
                                    }
                                    @(question.Header is { Length: > 0 } ? question.Header + " — " : "")@question.Question
                                    @if (question.MultiSelect)
                                    {
                                        <span class="question-hint">pick any</span>
                                    }
                                </div>
                                @if (question.Options is { Count: > 0 } options)
                                {
                                    <div class="question-options">
                                        @foreach (var option in options)
                                        {
                                            <button class="option chip @(IsSelected(question, option.Label) ? "selected" : "")"
                                                    title="@(option.Description ?? option.Label)"
                                                    @onclick="() => ToggleAnswer(question, option.Label)">
                                                @option.Label
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <input class="ask-input" type="text" placeholder="Type your answer…"
                                           value="@FreeText(question)"
                                           @oninput='args => SetFreeText(question, args.Value?.ToString() ?? "")' />
                                }
                            </div>
                        }
                    </div>
                    <div class="ask-actions">
                        <span class="ask-hint">Answers submit together</span>
                        <button class="primary" disabled="@(AnsweredCount(questions) < questions.Count || questions.Count == 0)"
                                @onclick="SubmitAnswers">Submit answers</button>
                    </div>
                </div>
            }
        </div>

        @if (_agent is { Inbox.HasPending: true })
        {
            <div class="queue-dock">
                @foreach (var queued in _agent.Inbox.NextTurn)
                {
                    <div class="queue-item">
                        <span class="queue-tag">queued</span>
                        @if (_editingQueue?.Id == queued.Id)
                        {
                            <input class="queue-edit" value="@_queueDraft" @oninput="OnQueueInput" @onkeydown="OnQueueKey" @onblur="() => SaveQueue(queued)" />
                        }
                        else
                        {
                            <span class="queue-text">@queued.FlattenText()</span>
                            <button class="link" @onclick="() => StartEditQueue(queued)">edit</button>
                        }
                        <button class="link" @onclick="() => SteerQueued(queued)" title="Run at the next step boundary instead of a new turn">steer now</button>
                        <button class="link" @onclick="() => RemoveQueued(queued)">remove</button>
                    </div>
                }
                @foreach (var steering in _agent.Inbox.NextStep)
                {
                    <div class="queue-item">
                        <span class="queue-tag steer">steering</span>
                        <span class="queue-text">@steering.FlattenText()</span>
                    </div>
                }
            </div>
        }
    }

    </div>

    @if (ShowTodos)
    {
        var todos = _snapshot!.Todos;
        var done = todos.Count(t => t.Status == TodoItem.Completed);
        <aside class="todo-panel" aria-label="Task list">
            <div class="todo-head">
                <span class="todo-head-title">Tasks</span>
                <span class="todo-count">@done/@todos.Count done</span>
                <button class="icon" title="Hide task list" aria-label="Hide task list" @onclick="() => _todosCollapsed = true">✕</button>
            </div>
            <div class="todo-list">
                @foreach (var todo in todos)
                {
                    <div class="todo-item @todo.Status">
                        <span class="todo-glyph">@TodoGlyph(todo.Status)</span>
                        <span class="todo-text">@todo.Content</span>
                    </div>
                }
            </div>
        </aside>
    }

    @if (ShowDelegations)
    {
        var agents = _snapshot!.Delegations;
        var running = agents.Count(d => d.Status == "running");
        <aside class="delegation-panel" aria-label="Delegated agents">
            <div class="delegation-head">
                <span class="todo-head-title">Agents</span>
                <span class="todo-count">@(running > 0 ? $"{running} running" : "all settled")</span>
                <button class="icon" title="Hide agents panel" aria-label="Hide agents panel" @onclick="() => _delegationsCollapsed = true">✕</button>
            </div>
            <div class="delegation-list">
                @foreach (var d in agents)
                {
                    <div class="delegation-item @d.Status">
                        <div class="delegation-item-head">
                            <span class="delegation-glyph">@DelegationGlyph(d.Status)</span>
                            <a class="delegation-desc" href="@($"/session/{d.ChildSessionId}")" title="Open this agent's session (read its full transcript)">
                                @(d.Description ?? d.ChildSessionId)
                            </a>
                            <span class="delegation-status">@d.Status</span>
                        </div>
                        @if (d.Summary is { Length: > 0 })
                        {
                            <div class="delegation-summary">@d.Summary</div>
                        }
                    </div>
                }
            </div>
        </aside>
    }
    </div>

    <footer class="composer" hidden="@(_view is "code" or "empty" || _sessionLoading || _loadError is not null)" aria-label="Chat message" data-session-id="@(_sessionLoading ? null : _loadedSessionId)">
        @if (!HasModelRoute)
        {
            <p class="settings-note">Select a provider and model to send messages. <a href="/settings">Configure providers in Settings</a>.</p>
        }
        <div class="command-menu" style="display:none" @ref="_slashMenu"></div>
        <div class="command-menu mention-menu" style="display:none" @ref="_mentionMenu"></div>
        @if (_pendingFiles.Count > 0)
        {
            <div class="file-chips">
                @foreach (var f in _pendingFiles)
                {
                    <span class="file-chip" title="@f.FileName — click to remove" @onclick="() => RemoveFile(f.Id)">
                        <span class="file-chip-icon">@FileChipIcon(f.Kind)</span>
                        <span class="file-chip-label">@f.FileName</span>
                        <span class="file-chip-remove">✕</span>
                    </span>
                }
            </div>
        }
        <div class="composer-bar">
            <span class="composer-clip">
                <input type="file" class="clip-input"
                       @ref="_clipInput" @onchange="OnClipInput" />
                <button class="ghost" title="Attach a file — screenshot, PDF, document, or text (paste and drop also work)"
                        aria-label="Attach file" @onclick="OpenClipInput">
                    <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.5 2.5v4.2h4.2M9.5 2.5H3.8v11.2h8.4V6.7L9.5 2.5z"/></svg>
                </button>
            </span>
            <span class="composer-cwd" title="@(_session?.Header.Cwd)">@WorkspaceLabel</span>
            <div class="composer-input">
                <textarea
                    @ref="_composerTa"
                    @bind="_draft"
                    @bind:event="oninput"
                    @onkeydown="OnKeyDown"
                    placeholder="@Placeholder"
                    rows="1"></textarea>
            </div>
            <div class="composer-actions">
                @if (_running)
                {
                    <button class="primary" disabled="@(!CanSend)" @onclick="SendQueue">Queue<span class="send-kbd"> (⏎)</span></button>
                    <button class="ghost" disabled="@(!CanSend || !HasModelRoute)" @onclick="SendSteer">Steer</button>
                    <button class="danger" @onclick="CancelTurn">Stop</button>
                }
                else
                {
                    <button class="primary" disabled="@(!CanSend)" @onclick="SendQueue">@(_draft.StartsWith('/') ? "Run" : (_draft.Length == 0 && _pendingFiles.Count > 0 ? "Send file" : "Send"))<span class="send-kbd"> (⏎)</span></button>
                }
            </div>
        </div>
    </footer>

    @if (DockOpen)
    {
        <div class="terminal-resize" title="Drag to resize the panel below the chat" @ref="_terminalResizeHandle"></div>
        <section class="bottom-dock terminal-drawer" aria-label="Terminal and run panel" @ref="_terminalDrawer">
            <div class="dock-head terminal-head">
                <div class="dock-tabs" role="tablist" aria-label="Bottom panel">
                    <button type="button" class="dock-tab @(_dockTab == "terminal" ? "on" : "")" role="tab" aria-selected="@(_dockTab == "terminal" ? "true" : "false")" @onclick='() => SelectDock("terminal")'>Terminal</button>
                    <button type="button" class="dock-tab @(_dockTab == "run" ? "on" : "")" role="tab" aria-selected="@(_dockTab == "run" ? "true" : "false")" @onclick='() => SelectDock("run")'>
                        Run @if (RunningCount > 0) { <span class="toolbar-count">@RunningCount</span> }
                    </button>
                </div>
                <span class="terminal-actions">
                    @if (_dockTab == "terminal" && _terminalId is not null)
                    {
                        <button class="link" title="Interrupt the running command (SIGINT)" @onclick="TerminalInterrupt">Ctrl+C</button>
                        <button class="link" @onclick="TerminalClearView">clear</button>
                        <button class="link danger" title="Kill the shell; Terminal reopens a fresh one" @onclick="TerminalKillShell">kill shell</button>
                    }
                    else if (_dockTab == "run" && SelectedRun is { Running: true } running)
                    {
                        <button class="link danger" title="Stop this run and its child processes" @onclick="() => StopRun(running.Id)">Stop</button>
                    }
                    <button class="icon terminal-close" title="Hide this panel" aria-label="Hide terminal and run panel" @onclick="CloseDock">✕</button>
                </span>
            </div>
            @if (_dockTab == "run")
            {
                <div class="run-dock">
                    <div class="run-list" aria-label="Tracked runs">
                        @if (_runs.Count == 0)
                        {
                            <div class="run-empty">No runs yet. Use Run in the header to start one.</div>
                        }
                        @foreach (var run in _runs)
                        {
                            <button type="button" class="run-row @(_selectedRunId == run.Id ? "active" : "") @(run.Running ? "running" : "")" @onclick="() => _selectedRunId = run.Id">
                                <span class="run-row-label">@run.Label</span>
                                <span class="run-row-state">@(run.Running ? (run.StopRequested ? "stopping" : "running") : run.StopRequested ? "stopped" : run.ExitCode is { } code ? $"exited {code}" : "finished")</span>
                            </button>
                        }
                    </div>
                    <div class="run-details">
                        @if (SelectedRun is { } selected)
                        {
                            <div class="run-detail-head"><code>@selected.CommandLine</code><span title="@selected.WorkingDirectory">@selected.WorkingDirectory</span></div>
                        }
                        <pre class="terminal-output run-output" @ref="_runOut">@(SelectedRun?.Output is { Length: > 0 } output ? output : "Output from the selected command appears here.")</pre>
                    </div>
                </div>
            }
            else
            {
                <pre class="terminal-output" @ref="_terminalOut">@(_terminalOutput.Length > 0 ? _terminalOutput : "Shell ready. Enter a command below.")</pre>
                @if (_terminalId is not null)
                {
                    <div class="terminal-input-row">
                        <span class="terminal-prompt">$</span>
                        <input class="terminal-input" value="@_terminalInput"
                               @oninput="OnTerminalInput"
                               @onkeydown="OnTerminalKey"
                               placeholder="shell command — Enter runs, ↑ recalls"
                               aria-label="Shell command"
                               spellcheck="false" />
                    </div>
                }
            }
        </section>
    }
</div>

@if (_modelMenu)
{
    var query = _modelSearch.Trim();
    var groups = Facade.Harness.Llm.ListProviders()
        .OrderByDescending(p => p == _draftProvider)
        .ThenBy(p => p, StringComparer.Ordinal)
        .Select(p => (Provider: p, Models: Facade.Harness.RuntimeModels(p)
            .Where(m => query.Length == 0
                || m.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                || m.Id.Contains(query, StringComparison.OrdinalIgnoreCase)
                || p.Contains(query, StringComparison.OrdinalIgnoreCase))
            .ToList()))
        .Where(g => g.Models.Count > 0)
        .ToList();
    var selectedModel = DraftModelInfo;
    <div class="modal-overlay" @onclick="CloseMenus">
        <div class="modal model-config" role="dialog" aria-modal="true" aria-labelledby="model-config-title"
             @onclick:stopPropagation="true" @onkeydown="OnSearchKey" @ref="_modelDialog">
            <div class="modal-head">
                <h3 id="model-config-title">Model and reasoning effort</h3>
                <button class="ghost" aria-label="Close model settings" @onclick="CloseMenus">Close</button>
            </div>
            <label class="modal-field">
                <span>Search models or providers</span>
                <input type="search" value="@_modelSearch" @oninput="OnModelSearch" @ref="_modelSearchInput" />
            </label>
            <div class="model-config-list" aria-label="Models">
                @foreach (var group in groups)
                {
                    <div class="popover-group">@group.Provider <span class="group-count">@group.Models.Count</span></div>
                    @foreach (var model in group.Models)
                    {
                        <button @key="(group.Provider, model.Id)" class="popover-item @(_draftProvider == group.Provider && _draftModel == model.Id ? "selected" : "")"
                                aria-pressed="@(_draftProvider == group.Provider && _draftModel == model.Id)"
                                @onclick="() => SelectModel(group.Provider, model.Id)">
                            @model.Name <span class="model-config-id">@model.Id</span>
                        </button>
                    }
                }
                @if (groups.Count == 0)
                {
                    <div class="popover-empty">No matching models. Load models on the Settings page if needed.</div>
                }
            </div>
            <div class="model-config-selection">Selected: @_draftProvider/@_draftModel</div>
            <label class="modal-field">
                <span>Reasoning effort</span>
                <select @bind="_draftEffort" disabled="@(selectedModel is null)">
                    <option value="">Model default@(selectedModel?.EffectiveDefaultEffort is { } defaultEffort ? $" ({defaultEffort})" : "")</option>
                    @foreach (var effort in selectedModel?.EffectiveReasoningEfforts ?? [])
                    {
                        <option value="@effort">@effort</option>
                    }
                </select>
            </label>
            @if (selectedModel is not null && selectedModel.ReasoningEfforts is not { Length: > 0 })
            {
                <div class="popover-empty">Reasoning levels are unknown for this model. These are generic choices; the provider decides which it accepts.</div>
            }
            <div class="modal-actions">
                <button class="ghost" @onclick="CloseMenus">Cancel</button>
                <button class="primary" disabled="@(selectedModel is null)" @onclick="ApplyModelSettings">Apply</button>
            </div>
        </div>
    </div>
}

@if (_docsOpen)
{
    <div class="modal-overlay" @onclick="CloseMenus">
        <div class="modal model-config" role="dialog" aria-modal="true" aria-labelledby="docs-init-title"
             @onclick:stopPropagation="true" @onkeydown="OnSearchKey">
            <div class="modal-head">
                <h3 id="docs-init-title">Generate workspace docs</h3>
                <button class="ghost" aria-label="Close docs generator" @onclick="CloseMenus">Close</button>
            </div>
            <div class="model-config-selection">Workspace: @(DocsRoot ?? "(none)")</div>
            <label class="modal-field">
                <span>Subdirectory depth</span>
                <select @bind="_docsDepth" @bind:after="RefreshDocsPreview">
                    <option value="0">Root file only</option>
                    <option value="1">1 level</option>
                    <option value="2">2 levels</option>
                    <option value="3">3 levels</option>
                </select>
            </label>
            <div class="model-config-list" aria-label="Planned docs">
                <div class="popover-group">Planned files <span class="group-count">@(_docsPreview?.Files.Count ?? 0)</span></div>
                @if (_docsPreview is not null)
                {
                    @foreach (var file in _docsPreview.Files)
                    {
                        <div class="popover-item">@(file.Exists ? "refresh" : "create") — @file.RelativePath <span class="model-config-id">@file.Content.Length chars</span></div>
                    }
                }
                <div class="popover-group">Unresolved path references <span class="group-count">@(_docsPreview?.StaleReferences.Count ?? 0)</span></div>
                @if (_docsPreview?.StaleReferences.Count > 0)
                {
                    @foreach (var stale in _docsPreview.StaleReferences.Take(20))
                    {
                        <div class="popover-item">@System.IO.Path.GetFileName(stale.DocPath):@stale.Line — <span class="model-config-id">@stale.Reference</span></div>
                    }
                    @if (_docsPreview.StaleReferences.Count > 20)
                    {
                        <div class="popover-empty">… and @(_docsPreview.StaleReferences.Count - 20) more</div>
                    }
                }
                else
                {
                    <div class="popover-empty">All path references resolve.</div>
                }
            </div>
            @if (_docsResult is not null)
            {
                <div class="model-config-selection">@_docsResult</div>
            }
            <div class="modal-actions">
                <button class="ghost" @onclick="CloseMenus">Cancel</button>
                <button class="primary" disabled="@(_docsPreview is null || DocsRoot is null || _docsGenerating)" @onclick="ApplyDocsInit">@(_docsGenerating ? "Drafting…" : "Generate files")</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string SessionId { get; set; } = "";

