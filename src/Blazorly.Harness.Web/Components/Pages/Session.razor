        WorkspaceUi.Changed -= OnWorkspaceUiChanged;
        _coalesce?.Dispose();
        _copyFlash?.Dispose();
        _subscription?.Dispose();
        _terminalPoll?.Dispose();
        _runPoll?.Dispose();
        _slashRef?.Dispose();
        _topGrowRef?.Dispose();
        _imageRef?.Dispose();
    }
