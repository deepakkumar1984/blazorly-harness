@using Blazorly.Harness.Web.Services
@inject SessionFacade Facade
@inject IJSRuntime Js
@inject WorkspaceUiState WorkspaceUi
@inject WorkspaceDeletionService WorkspaceDeletion
@implements IDisposable

<div class="app-shell">
    <div class="mobile-bar">
        <button class="icon mobile-menu" title="Toggle navigation" aria-label="Toggle navigation" @onclick='() => _drawerOpen = !_drawerOpen'>☰</button>
        <span class="mobile-title">Blazorly <span>Harness</span></span>
    </div>
    <aside class="sidebar @(_drawerOpen ? "open" : "")" aria-label="Workspace navigation" @onkeydown="OnSidebarKey">
        <div class="brand">
            <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="m13 3-8 10h6l-1 8 9-11h-6z" /></svg></span>
            <span class="brand-name">Blazorly <span>Harness</span></span>
            <a class="icon brand-settings" href="/settings" title="Settings" aria-label="Settings">
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>
            </a>
        </div>
        <div class="ws-switch">
            <button type="button" class="ws-current" title="Switch workspace — @ActiveWorkspaceRoot" aria-haspopup="menu" aria-expanded="@(_switcherOpen ? "true" : "false")" @onclick="ToggleSwitcher">
                <span class="ws-current-row">
                    <span class="ws-current-name">@ActiveWorkspaceLabel</span>
                    <span class="ws-caret" aria-hidden="true">▾</span>
                </span>
            </button>
            @if (_switcherOpen)
            {
                <div class="menu-backdrop" @onclick="CloseSwitcher"></div>
                <div class="popover ws-menu" role="menu" aria-label="Workspaces">
                    <div class="popover-group">Your workspaces</div>
                    @foreach (var workspace in Facade.Workspaces().OrderBy(w => w.Order))
                    {
                        var selected = workspace.Id == ActiveWorkspaceKey;
                        <div class="ws-option @(selected ? "selected" : "")">
                            <button type="button" class="ws-option-main" title="@workspace.Root" role="menuitemradio" aria-checked="@(selected ? "true" : "false")" @onclick="() => SwitchWorkspace(workspace.Id)">
                                <span class="ws-option-name">@workspace.Name @(selected ? "· current" : "")</span>
                                <span class="ws-option-root">@workspace.Root</span>
                            </button>
                            <button type="button" class="icon" role="menuitem" title="Rename workspace" aria-label="@($"Rename {workspace.Name}")" @onclick="() => AskRenameWorkspace(workspace)">✎</button>
                            <button type="button" class="icon danger" role="menuitem" title="Delete workspace and its files" aria-label="@($"Delete {workspace.Name}")" @onclick="() => AskRemoveWorkspace(workspace)">✕</button>
                        </div>
                    }
                    @if (UnfiledCount > 0)
                    {
                        <button type="button" class="ws-option-main unfiled" role="menuitemradio" aria-checked="@(ActiveWorkspaceKey == UnfiledId ? "true" : "false")" @onclick="() => SwitchWorkspace(UnfiledId)">
                            <span class="ws-option-name">Unfiled @(ActiveWorkspaceKey == UnfiledId ? "· current" : "")</span>
                            <span class="ws-option-root">@UnfiledCount chat(s) with no folder</span>
                        </button>
                    }
                    <button type="button" class="ws-add" role="menuitem" @onclick="OpenAddFromSwitcher">＋ Add workspace</button>
                </div>
            }
        </div>
        <div class="workspace-nav-tabs" role="tablist" aria-label="Workspace explorer" @onkeydown="OnWorkspaceTabKey">
            <button type="button" id="workspace-chats-tab" role="tab" title="Chats" aria-label="Chats" tabindex="@(WorkspaceUi.SidebarTab == "chats" ? 0 : -1)" aria-selected="@(WorkspaceUi.SidebarTab == "chats" ? "true" : "false")" aria-controls="workspace-chats-panel" class="workspace-nav-tab @(WorkspaceUi.SidebarTab == "chats" ? "active" : "")" @onclick="WorkspaceUi.ShowChats">
                <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M2.5 3h11v7H9l-3.5 3v-3h-3z" /></svg>
                <span class="nav-count">@VisibleLive().Count()</span>
            </button>
            <button type="button" id="workspace-files-tab" role="tab" title="Files" aria-label="Files" tabindex="@(WorkspaceUi.SidebarTab == "files" ? 0 : -1)" aria-selected="@(WorkspaceUi.SidebarTab == "files" ? "true" : "false")" aria-controls="workspace-files-panel" class="workspace-nav-tab @(WorkspaceUi.SidebarTab == "files" ? "active" : "")" @onclick="WorkspaceUi.ShowFiles">
                <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M2 4h4l1.5 1.5H14v7H2zM2 4V2.5h4l1.5 1.5H13v1.5" /></svg>
            </button>
            <button type="button" id="workspace-changes-tab" role="tab" title="Changes" aria-label="Changes" tabindex="@(WorkspaceUi.SidebarTab == "changes" ? 0 : -1)" aria-selected="@(WorkspaceUi.SidebarTab == "changes" ? "true" : "false")" aria-controls="workspace-changes-panel" class="workspace-nav-tab @(WorkspaceUi.SidebarTab == "changes" ? "active" : "")" @onclick="WorkspaceUi.ShowChanges">
                <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><circle cx="4.5" cy="3.5" r="1.5" /><circle cx="4.5" cy="12.5" r="1.5" /><circle cx="11.5" cy="8" r="1.5" /><path d="M4.5 5.2v5.6M4.5 8h5.3" /></svg>
            </button>
            <button type="button" class="workspace-nav-tab workspace-nav-add" title="New chat" aria-label="New chat" @onclick="NewChatInActive" @onkeydown:stopPropagation="true">
                <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M8 2.5v11M2.5 8h11" /></svg>
            </button>
        </div>
        <section id="workspace-chats-panel" class="workspace-sidebar-panel" role="tabpanel" aria-labelledby="workspace-chats-tab" hidden="@(WorkspaceUi.SidebarTab != "chats")">
        <div class="sidebar-search">
            <input type="search" placeholder="Search this workspace…" aria-label="Search chats in this workspace" @bind="_search" @bind:event="oninput" @bind:after="SearchChanged" />
        </div>
        @if (_search.Trim().Length >= 2)
        {
            <div class="search-results">
                @if (_hits.Count == 0)
                {
                    <div class="explorer-empty">No matching chats in this workspace.</div>
                }
                @foreach (var hit in _hits)
                {
                    <a class="search-hit" href="@($"/session/{hit.SessionId}")" @onclick="() => OpenChat(hit.SessionId)" @onclick:preventDefault="true">
                        <span class="hit-kind">@hit.Kind</span>
                        <span class="hit-snip">@hit.Snippet</span>
                    </a>
                }
            </div>
        }
        else
        {
            <nav class="session-list" aria-label="Chats in this workspace">
                @foreach (var item in VisibleLive())
                {
                    <div class="session-row">
                        <a class="session-item @(item.Id == ActiveSessionId ? "active" : "")" href="@($"/session/{item.Id}")" @onclick="() => OpenChat(item.Id)" @onclick:preventDefault="true">
                            <span class="session-dot @(item.Running ? "running" : "")"></span>
                            <span class="session-title">@item.Title</span>
                        </a>
                        <button class="icon archive" title="@(item.Archived ? "Unarchive" : "Archive")" @onclick="() => ToggleArchive(item.Id, item.Archived)">
                            @(item.Archived ? "↩" : "🗄")
                        </button>
                        <button class="icon danger delete" title="Delete chat" @onclick="() => AskDelete(item)">🗑</button>
                    </div>
                }
                @if (!VisibleLive().Any())
                {
                    <div class="workspace-empty">No chats in this workspace yet.</div>
                }
                @if (VisibleArchived().Any())
                {
                    <div class="workspace-group">
                        <button type="button" class="workspace-head archived-toggle" aria-expanded="@(_archivedOpen ? "true" : "false")" @onclick="ToggleShowArchived">
                            <span class="workspace-name">🗄 @($"{VisibleArchived().Count()} archived")</span>
                            <span class="workspace-actions"><span class="icon">@(_archivedOpen ? "▴" : "▾")</span></span>
                        </button>
                        @if (_archivedOpen)
                        {
                            foreach (var item in VisibleArchived())
                            {
                                <div class="session-row archived">
                                    <a class="session-item" href="@($"/session/{item.Id}")" @onclick="() => OpenChat(item.Id)" @onclick:preventDefault="true">
                                        <span class="session-dot"></span>
                                        <span class="session-title">@item.Title</span>
                                    </a>
                                    <button class="icon archive" title="Unarchive" @onclick="() => ToggleArchive(item.Id, true)">↩</button>
                                    <button class="icon danger delete" title="Delete chat" @onclick="() => AskDelete(item)">🗑</button>
                                </div>
                            }
                        }
                    </div>
                }
            </nav>
        }
        </section>
        <section id="workspace-files-panel" class="workspace-sidebar-panel" role="tabpanel" aria-labelledby="workspace-files-tab" hidden="@(WorkspaceUi.SidebarTab != "files")">
            <WorkspaceExplorer Root="@ExplorerRoot" SelectedPath="@WorkspaceUi.ActiveFile" Visible="@(WorkspaceUi.SidebarTab == "files")" OnOpenFile="OpenWorkspaceFile" OnDeleted="OnExplorerDeleted" OnRenamed="OnExplorerRenamed" />
        </section>
        <section id="workspace-changes-panel" class="workspace-sidebar-panel" role="tabpanel" aria-labelledby="workspace-changes-tab" hidden="@(WorkspaceUi.SidebarTab != "changes")">
            <SourceControl Root="@ExplorerRoot" Visible="@(WorkspaceUi.SidebarTab == "changes")" />
        </section>
    </aside>
    <main class="chat-pane">@Body</main>
</div>
@if (_drawerOpen)
{
    <button class="sidebar-scrim" aria-label="Close navigation" @onclick='() => _drawerOpen = false'></button>
}

@if (_showAddWorkspace)
{
    <div class="modal-overlay" @onclick="CloseAddWorkspace">
        <div class="modal" role="dialog" aria-modal="true" aria-label="Add workspace" @onclick:stopPropagation="true" @onkeydown="OnModalKey">
            <div class="modal-head">
                <h3>Add workspace</h3>
                <button class="icon modal-close" title="Close (Esc)" @onclick="CloseAddWorkspace">✕</button>
            </div>
            <div class="browse-quick">
                <span class="browse-quick-label">Jump to</span>
                <button type="button" class="chip" @onclick='() => Browse(Facade.HomeDirectory)'>🏠 home</button>
                <button type="button" class="chip" @onclick='() => Browse(Path.GetPathRoot(_browsePath) ?? "/")'>@(Path.GetPathRoot(_browsePath) ?? "/")</button>
                <button type="button" class="chip" @onclick="BrowseParent" disabled="@(_browseParent is null)" title="Up one folder">↑ up</button>
            </div>
            <div class="browse-path"><code>@_browsePath</code></div>
            <div class="browse-list">
                @if (_browseEntries.Count == 0)
                {
                    <div class="browse-empty">no subfolders here</div>
                }
                @foreach (var entry in _browseEntries)
                {
                    <button type="button" class="browse-entry" @onclick="() => Browse(entry.FullPath)">
                        <span class="browse-entry-icon">📁</span><span class="browse-entry-name">@entry.Name</span>
                        @if (entry.Empty)
                        {
                            <span class="browse-entry-hint" title="This folder has no files yet">empty</span>
                        }
                    </button>
                }
            </div>
            <div class="browse-select-row">
                <span class="browse-selected">Selected: <code>@(_workspaceRoot.Length > 0 ? _workspaceRoot : _browsePath)</code></span>
                <button type="button" class="ghost" @onclick="UseCurrentFolder" title="Pick the folder shown in the list above">Use this folder</button>
            </div>
            <label class="browse-pick">
                <span>Folder path</span>
                <input type="text" @ref="_folderInput" @bind="_workspaceRoot" @bind:event="oninput" placeholder="@(OperatingSystem.IsWindows() ? @"C:\Work\my-app" : "/home/you/projects/my-app")" />
            </label>
            <label class="browse-pick">
                <span>Display name</span>
                <input type="text" placeholder="(folder name)" @bind="_workspaceName" @bind:event="oninput" />
            </label>
            @if (_workspaceError is { Length: > 0 })
            {
                <div class="form-error">@_workspaceError</div>
            }
            <label class="browse-check">
                <input type="checkbox" @bind="_startChatAfterAdd" />
                <span>Open a new chat in it right away</span>
            </label>
            <div class="modal-actions">
                <button class="ghost" @onclick="CloseAddWorkspace">Cancel</button>
                <button class="primary" @onclick="AddWorkspace">Add workspace</button>
            </div>
        </div>
    </div>
}

@if (_confirmRemoveWorkspace is { } remove)
{
    <div class="modal-overlay" @onclick="CloseDeleteWorkspace">
        <div class="modal confirm-modal" role="alertdialog" aria-modal="true" aria-label="Delete workspace" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>Delete workspace permanently?</h3>
                <button class="icon modal-close" title="Cancel" disabled="@_workspaceDeleteBusy" @onclick="CloseDeleteWorkspace">✕</button>
            </div>
            <p class="confirm-text">
                Delete “@remove.Name”, its chats and child sessions, their attachments, and the local folder below with all its files.
                Active work will be stopped. This cannot be undone.
            </p>
            <p class="confirm-text workspace-delete-path"><code>@remove.Root</code></p>
            @if (_workspaceDeletePreview is { } preview)
            {
                <p class="confirm-text">@preview.Sessions.Count session(s), including child sessions, will be deleted.</p>
            }
            else if (_workspaceDeleteError is null) { <p class="confirm-text">Checking workspace contents…</p> }
            @if (_workspaceDeleteError is not null) { <div class="form-error" role="alert">@_workspaceDeleteError</div> }
            <div class="modal-actions">
                <button class="ghost" disabled="@_workspaceDeleteBusy" @onclick="CloseDeleteWorkspace">Cancel</button>
                <button class="danger" disabled="@(_workspaceDeleteBusy || _workspaceDeletePreview is null)" @onclick="() => RemoveWorkspaceConfirmed(remove)">@(_workspaceDeleteBusy ? "Deleting…" : "Delete workspace and files")</button>
            </div>
        </div>
    </div>
}

@if (_renameWorkspace is { } rename)
{
    <div class="modal-overlay" @onclick="CloseRenameWorkspace">
        <div class="modal confirm-modal" role="dialog" aria-modal="true" aria-label="Rename workspace" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>Rename workspace</h3>
                <button class="icon modal-close" title="Cancel" @onclick="CloseRenameWorkspace">✕</button>
            </div>
            <label class="browse-pick">
                <span>Display name</span>
                <input type="text" @bind="_renameWorkspaceName" @bind:event="oninput" @onkeydown="OnRenameKey" />
            </label>
            <p class="confirm-text"><code>@rename.Root</code></p>
            <div class="modal-actions">
                <button class="ghost" @onclick="CloseRenameWorkspace">Cancel</button>
                <button class="primary" disabled="@string.IsNullOrWhiteSpace(_renameWorkspaceName)" @onclick="RenameWorkspace">Save name</button>
            </div>
        </div>
    </div>
}

@if (_confirmDelete is { } doomed)
{
    <div class="modal-overlay" @onclick='() => _confirmDelete = null'>
        <div class="modal confirm-modal" role="alertdialog" aria-modal="true" aria-label="Delete chat" @onclick:stopPropagation="true">
            <div class="modal-head">
                <h3>Delete chat?</h3>
                <button class="icon modal-close" title="Cancel" @onclick='() => _confirmDelete = null'>✕</button>
            </div>
            <p class="confirm-text">
                “@doomed.Title” and its entire transcript will be permanently deleted.
                This cannot be undone.
            </p>
            @if (_deleteError is { Length: > 0 })
            {
                <div class="form-error">@_deleteError</div>
            }
            <div class="modal-actions">
                <button class="ghost" @onclick='() => _confirmDelete = null'>Cancel</button>
                <button class="danger" @onclick="DeleteConfirmed" disabled="@doomed.Running">Delete chat</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? ActiveSessionId { get; set; }
    [Parameter] public RenderFragment? Body { get; set; }

    public sealed record SessionItem(string Id, string Title, bool Running, bool Archived, string WorkspaceId);

    private List<SessionItem> _sessions = [];
    private string _search = "";
    private IReadOnlyList<SessionFacade.SearchHit> _hits = [];
    private List<SessionItem> _showArchived = [];
    private bool _archivedOpen;
    private bool _showAddWorkspace;
    private string _browsePath = "/";
    private string? _browseParent;
    private List<DirectoryEntry> _browseEntries = [];
    private string _workspaceRoot = "";
    private string _workspaceName = "";
    private string _workspaceError = "";
    private System.Timers.Timer? _refresh;
    private bool _drawerOpen;
    private bool _startChatAfterAdd = true;
    private bool _switcherOpen;
    private bool _disposed;
    private Workspace? _renameWorkspace;
    private string _renameWorkspaceName = "";
    private Workspace? _confirmRemoveWorkspace;
    private WorkspaceDeletionPreview? _workspaceDeletePreview;
    private bool _workspaceDeleteBusy;
    private string? _workspaceDeleteError;
    private SessionItem? _confirmDelete;
    private string? _deleteError;

    private void AskDelete(SessionItem item)
    {
        _deleteError = null;
        _confirmDelete = item;
    }

    private async Task DeleteConfirmed()
    {
        if (_confirmDelete is not { } doomed) return;
        var error = await Facade.DeleteSession(doomed.Id);
        if (error is not null)
        {
            _deleteError = error;
            await InvokeAsync(StateHasChanged);
            return;
        }
        var wasActive = doomed.Id == ActiveSessionId;
        _confirmDelete = null;
        _deleteError = null;
        WorkspaceUi.CloseTab(WorkspaceTab.ChatKey(doomed.Id));
        Refresh();
        if (wasActive && WorkspaceUi.ActiveTab is not { IsChat: true }) Navigation.NavigateTo("/", forceLoad: false);
    }

    [Inject] private Microsoft.AspNetCore.Components.NavigationManager Navigation { get; set; } = null!;

    protected override void OnInitialized()
    {
        Refresh();
        _ = Browse("/");
        _refresh = new System.Timers.Timer(1200);
        _refresh.Elapsed += (_, _) => _ = InvokeAsync(() => { if (!_disposed && !_showAddWorkspace) Refresh(); });
        _refresh.AutoReset = true;
        _refresh.Enabled = true;
        Navigation.LocationChanged += OnLocationChanged;
        WorkspaceUi.Changed += OnWorkspaceUiChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            _drawerOpen = false;
            _switcherOpen = false;
            ClearSearch();
            Refresh();
        });
    }

    private void OnWorkspaceUiChanged() => _ = InvokeAsync(() => { if (!_disposed) StateHasChanged(); });

    private void OnSidebarKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { _switcherOpen = false; _drawerOpen = false; }
    }

    private static readonly string[] SidebarTabOrder = ["chats", "files", "changes"];

    private async Task OnWorkspaceTabKey(KeyboardEventArgs e)
    {
        if (e.Key is not ("ArrowLeft" or "ArrowRight" or "Home" or "End")) return;
        var current = Array.IndexOf(SidebarTabOrder, WorkspaceUi.SidebarTab);
        if (current < 0) current = 0;
        var next = e.Key switch
        {
            "Home" => 0,
            "End" => SidebarTabOrder.Length - 1,
            "ArrowRight" => (current + 1) % SidebarTabOrder.Length,
            _ => (current + SidebarTabOrder.Length - 1) % SidebarTabOrder.Length,
        };
        var tab = SidebarTabOrder[next];
        if (tab == "files") WorkspaceUi.ShowFiles();
        else if (tab == "changes") WorkspaceUi.ShowChanges();
        else WorkspaceUi.ShowChats();
        try { await Js.InvokeVoidAsync("blazorly.focusById", $"workspace-{tab}-tab"); }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or ObjectDisposedException) { }
    }

    private bool _awaitFolderFocus;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_awaitFolderFocus && _showAddWorkspace)
        {
            _awaitFolderFocus = false;
            await FocusFolderInput();
        }
    }

    private const string UnfiledId = "unfiled";

    private string ActiveWorkspaceKey
    {
        get
        {
            if (ActiveSessionId is { Length: > 0 }
                && Facade.Harness.Sessions.Get(ActiveSessionId) is { } session)
                return Facade.WorkspaceOf(session)?.Id ?? UnfiledId;
            try { return Facade.Harness.Workspaces.Default().Id; }
            catch (InvalidOperationException) { return UnfiledId; }
        }
    }

    private Workspace? CurrentWorkspace()
        => Facade.Workspaces().FirstOrDefault(w => w.Id == ActiveWorkspaceKey);

    private string ActiveWorkspaceLabel => CurrentWorkspace()?.Name ?? (UnfiledCount > 0 ? "Unfiled" : "No workspace");

    private string ActiveWorkspaceRoot => CurrentWorkspace()?.Root ?? "Chats outside a registered workspace";

    private string? ExplorerRoot => CurrentWorkspace()?.Root;

    private int UnfiledCount => _sessions.Count(s => s.WorkspaceId == UnfiledId);

    private IEnumerable<SessionItem> VisibleLive()
        => _sessions.Where(s => !s.Archived && s.WorkspaceId == ActiveWorkspaceKey);

    private IEnumerable<SessionItem> VisibleArchived()
        => _showArchived.Where(s => s.WorkspaceId == ActiveWorkspaceKey);

    private void ToggleSwitcher() => _switcherOpen = !_switcherOpen;

    private void CloseSwitcher() => _switcherOpen = false;

    private void OpenAddFromSwitcher()
    {
        _switcherOpen = false;
        OpenAddWorkspace();
    }

    private void SwitchWorkspace(string id)
    {
        _switcherOpen = false;
        _drawerOpen = false;
        ClearSearch();
        if (id == UnfiledId)
        {
            var unfiled = _sessions.Where(s => s.WorkspaceId == UnfiledId).OrderBy(s => s.Archived).FirstOrDefault();
            if (unfiled is not null) OpenChat(unfiled.Id);
            return;
        }
        if (Facade.Harness.Workspaces.Get(id) is null) return;
        var latest = Facade.LiveSessions()
            .Where(s => s.Header.ParentSession is null && !Facade.IsArchived(s.Id))
            .Where(s => Facade.WorkspaceOf(s)?.Id == id)
            .OrderBy(s => s.Header.CreatedAt)
            .LastOrDefault();
        if (latest is not null) OpenChat(latest.Id);
        else NewSessionIn(id);
    }

    private void OpenWorkspaceFile(string relativePath)
    {
        if (ExplorerRoot is not { Length: > 0 } root) return;
        WorkspaceUi.OpenFile(root, relativePath);
        _drawerOpen = false;
        if (ActiveSessionId is null) SwitchWorkspace(ActiveWorkspaceKey);
    }

    private void OnExplorerDeleted(string relativePath)
    {
        if (ExplorerRoot is not { Length: > 0 } root) return;
        WorkspaceUi.NotifyFilesDeleted(root, [relativePath]);
    }

    private void OnExplorerRenamed(WorkspaceExplorer.FileRenamedEvent renamed)
    {
        if (ExplorerRoot is not { Length: > 0 } root) return;
        WorkspaceUi.NotifyFileRenamed(root, renamed.OldPath, renamed.NewPath);
    }

    private void AskRenameWorkspace(Workspace workspace)
    {
        _switcherOpen = false;
        _renameWorkspace = workspace;
        _renameWorkspaceName = workspace.Name;
    }

    private void CloseRenameWorkspace() => _renameWorkspace = null;

    private void OnRenameKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseRenameWorkspace();
        else if (e.Key == "Enter") RenameWorkspace();
    }

    private void RenameWorkspace()
    {
        if (_renameWorkspace is not { } workspace || string.IsNullOrWhiteSpace(_renameWorkspaceName)) return;
        Facade.RenameWorkspace(workspace.Id, _renameWorkspaceName.Trim());
        CloseRenameWorkspace();
        Refresh();
    }

    private void NewChatInActive()
    {
        var workspace = CurrentWorkspace();
        if (workspace is null)
        {
            try { workspace = Facade.Harness.Workspaces.Default(); }
            catch (InvalidOperationException)
            {
                OpenAddWorkspace();
                return;
            }
        }
        Facade.Harness.Workspaces.SetDefault(workspace.Id);
        NewSessionIn(workspace.Id);
    }

    private async Task AskRemoveWorkspace(Workspace workspace)
    {
        _switcherOpen = false;
        _confirmRemoveWorkspace = workspace;
        _workspaceDeletePreview = null;
        _workspaceDeleteError = null;
        try { _workspaceDeletePreview = await WorkspaceDeletion.PreviewAsync(workspace.Id); }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException or ArgumentException)
        {
            _workspaceDeleteError = ex.Message;
        }
    }

    private void CloseDeleteWorkspace()
    {
        if (!_workspaceDeleteBusy) _confirmRemoveWorkspace = null;
    }

    private async Task RemoveWorkspaceConfirmed(Workspace workspace)
    {
        if (_workspaceDeleteBusy || _workspaceDeletePreview is null) return;
        var wasActive = workspace.Id == ActiveWorkspaceKey;
        _workspaceDeleteBusy = true;
        _workspaceDeleteError = null;
        try
        {
            await WorkspaceDeletion.DeleteAsync(workspace.Id, workspace.Root);
            WorkspaceUi.WorkspaceDeleted(workspace.Root);
            _confirmRemoveWorkspace = null;
            Refresh();
            if (wasActive) Navigation.NavigateTo("/");
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException or ArgumentException or TimeoutException or System.ComponentModel.Win32Exception)
        {
            _workspaceDeleteError = $"Deletion could not finish: {ex.Message} You can retry.";
        }
        finally { _workspaceDeleteBusy = false; }
    }

    private async Task FocusFolderInput()
    {
        try { await _folderInput.FocusAsync(); }
        catch (JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

    private string? CurrentSessionId()
    {
        var match = System.Text.RegularExpressions.Regex.Match(Navigation.Uri, "/session/([^/?]+)");
        return match.Success ? match.Groups[1].Value : null;
    }

    private void Refresh()
    {
        ActiveSessionId = CurrentSessionId();
        var items = new List<SessionItem>();
        var live = new List<SessionItem>();
        foreach (var session in Facade.LiveSessions())
        {
            // Delegated children are not chats: they run inside the parent chat and surface as
            // its delegations panel. Keeping them out of the sidebar prevents "a new chat
            // appeared and is asking me things" confusion.
            if (session.Header.ParentSession is not null) continue;
            var agent = Facade.Harness.Agents.Get(session.Id);
            var workspaceId = Facade.WorkspaceOf(session)?.Id ?? UnfiledId;
            var item = new SessionItem(session.Id, SessionFacade.DeriveTitle(session), agent?.Status == "running", Facade.IsArchived(session.Id), workspaceId);
            WorkspaceUi.UpdateChatTitle(session.Id, item.Title);
            items.Add(item);
            if (!item.Archived) live.Add(item);
        }
        _sessions = items.OrderByDescending(s => s.Running).ToList();
        _showArchived = [.. items.Where(s => s.Archived)];
        _ = InvokeAsync(StateHasChanged);
    }

    private Task SearchChanged()
    {
        var ids = _sessions.Where(s => s.WorkspaceId == ActiveWorkspaceKey).Select(s => s.Id).ToHashSet();
        _hits = _search.Trim().Length >= 2 ? Facade.Search(_search).Where(h => ids.Contains(h.SessionId)).ToList() : [];
        return Task.CompletedTask;
    }

    private void ClearSearch()
    {
        _search = "";
        _hits = [];
    }

    private void NewSessionIn(string workspaceId)
    {
        var session = Facade.CreateSession(workspaceId);
        OpenChat(session.Id);
    }

    private void OpenChat(string sessionId)
    {
        ClearSearch();
        _drawerOpen = false;
        WorkspaceUi.RequestChat(sessionId);
        if (CurrentSessionId() != sessionId) Navigation.NavigateTo($"/session/{sessionId}");
    }

    private void ToggleArchive(string sessionId, bool currentlyArchived)
    {
        Facade.Archive(sessionId, !currentlyArchived);
        Refresh();
    }

    private void ToggleShowArchived() => _archivedOpen = !_archivedOpen;

    private Microsoft.AspNetCore.Components.ElementReference _folderInput;

    private void OpenAddWorkspace()
    {
        _workspaceError = "";
        _showAddWorkspace = true;
        _awaitFolderFocus = true;
        _ = Browse(_browsePath);
    }

    private void CloseAddWorkspace() => _showAddWorkspace = false;

    private void OnModalKey(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseAddWorkspace();
    }

    private void UseCurrentFolder()
    {
        _workspaceRoot = _browsePath;
        if (_workspaceName.Trim().Length == 0)
        {
            var name = System.IO.Path.GetFileName(Path.TrimEndingDirectorySeparator(_browsePath));
            _workspaceName = name.Length > 0 ? name : _browsePath;
        }
    }

    private async Task Browse(string path)
    {
        try
        {
            _workspaceError = "";
            var listing = Facade.BrowseFolders(path);
            _browsePath = listing.Path;
            _browseParent = listing.Parent;
            _browseEntries = [.. listing.Entries];
            // The folder you are looking at is the tentative selection; a stale pin must not win.
            if (_workspaceRoot.Length > 0 && !string.Equals(_workspaceRoot, listing.Path, StringComparison.Ordinal))
            {
                _workspaceRoot = "";
                _workspaceName = "";
            }
        }
        catch (Exception ex)
        {
            _workspaceError = ex.Message;
        }
        await InvokeAsync(StateHasChanged);
    }

    private Task BrowseParent() => _browseParent is null ? Task.CompletedTask : Browse(_browseParent);

    private async Task AddWorkspace()
    {
        _workspaceError = "";
        try
        {
            var workspace = Facade.AddWorkspace(_workspaceName, _workspaceRoot.Length > 0 ? _workspaceRoot : _browsePath);
            _showAddWorkspace = false;
            _workspaceRoot = "";
            _workspaceName = "";
            Refresh();
            if (_startChatAfterAdd) NewSessionIn(workspace.Id);
        }
        catch (Exception ex)
        {
            _workspaceError = ex.Message;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Navigation.LocationChanged -= OnLocationChanged;
        WorkspaceUi.Changed -= OnWorkspaceUiChanged;
        _refresh?.Dispose();
    }
}
