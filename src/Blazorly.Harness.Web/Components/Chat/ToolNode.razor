@using Blazorly.Harness.Web.Services
@implements IDisposable

<div class="tool-row @Node.ToolStatus">
    <button class="tool-summary" @onclick="Toggle">
        <span class="tool-dot @Node.ToolStatus"></span>
        <span class="tool-name">@Node.ToolName</span>
        <span class="tool-title">@(Node.CallView?.Title ?? CompactArgs)</span>
        @if (ResultPreview.Length > 0)
        {
            <span class="tool-preview">@ResultPreview</span>
        }
        @if (Node.ToolStatus == "running")
        {
            @if (Node.StartedAt is { } started)
            {
                <span class="tool-state">@ConversationNode.ElapsedLabel(started)</span>
            }
        }
        else if (Node.DurationMs is { } ms)
        {
            <span class="tool-state">@(ms >= 1000 ? $"{ms / 1000.0:F1}s" : $"{ms}ms")</span>
        }
        <span class="tool-state">@(Node.ToolStatus == "running" ? "…" : Node.ToolStatus == "error" ? "✕ failed" : "✓")</span>
    </button>
    @if (_expanded)
    {
        <div class="tool-detail">
            @if (Node.CallView?.Card == "diff" && Node.CallView.Diff is { } diff)
            {
                <div class="diff-card">
                    <div class="diff-path">@diff.Path</div>
                    <pre class="diff-old">@diff.OldText</pre>
                    <pre class="diff-new">@diff.NewText</pre>
                </div>
            }
            else
            {
                var argsJson = ArgsJsonElement;
                @if (argsJson is not null)
                {
                    <div class="io-views">
                        <button class="@(!_rawArgs ? "on" : "")" @onclick='() => _rawArgs = false'>tree</button>
                        <button class="@(_rawArgs ? "on" : "")" @onclick='() => _rawArgs = true'>raw</button>
                    </div>
                    @if (_rawArgs)
                    {
                        <div class="io-card">
                            <div class="io-label">arguments</div>
                            <pre>@PrettyArgs</pre>
                        </div>
                    }
                    else
                    {
                        <div class="io-card">
                            <div class="io-label">arguments</div>
                            <JsonTree Root="argsJson.Value" />
                        </div>
                    }
                }
                else
                {
                    <div class="io-card">
                        <div class="io-label">arguments</div>
                        <pre>@PrettyArgs</pre>
                    </div>
                }
            }
            @if (Node.ResultText is { Length: > 0 })
            {
                var structured = ResultJson;
                @if (structured is not null)
                {
                    <div class="io-views">
                        <button class="@(!_rawResult ? "on" : "")" @onclick='() => _rawResult = false'>tree</button>
                        <button class="@(_rawResult ? "on" : "")" @onclick='() => _rawResult = true'>raw</button>
                    </div>
                    @if (_rawResult)
                    {
                        <div class="io-card">
                            <div class="io-label">result</div>
                            <pre class="result @Node.ToolStatus">@DisplayResult</pre>
                        </div>
                    }
                    else
                    {
                        <div class="io-card">
                            <div class="io-label">result</div>
                            <JsonTree Root="structured.Value" />
                        </div>
                    }
                }
                else
                {
                    <div class="io-card">
                        <div class="io-label">result</div>
                        <pre class="result @Node.ToolStatus">@DisplayResult</pre>
                    </div>
                }
            }
            else if (Node.ToolStatus == "running")
            {
                <div class="io-card running">@(Node.StartedAt is { } started ? $"running {ConversationNode.ElapsedLabel(started)}…" : "running…")</div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public ConversationNode Node { get; set; } = null!;
    private bool _expanded;
    private bool _rawResult;
    private bool _rawArgs;
    private System.Text.Json.JsonElement? _resultJson;
    private bool _resultParsed;
    private System.Timers.Timer? _elapsedTick;
    private volatile bool _disposed;

    protected override void OnParametersSet()
    {
        // A running card self-ticks: long tool runs (minute-plus bash, exit_plan_mode holds)
        // otherwise sit frozen on the page — the elapsed label proves the run is alive.
        if (Node.ToolStatus != "running") { StopTick(); return; }
        if (_elapsedTick is not null) return;
        _elapsedTick = new System.Timers.Timer(1000) { AutoReset = true };
        _elapsedTick.Elapsed += (_, _) =>
        {
            if (_disposed) return;
            try { _ = InvokeAsync(StateHasChanged); } catch (ObjectDisposedException) { }
        };
        _elapsedTick.Start();
    }

    private void StopTick()
    {
        _elapsedTick?.Stop();
        _elapsedTick?.Dispose();
        _elapsedTick = null;
    }

    void IDisposable.Dispose() { _disposed = true; StopTick(); }

    /// <summary>Result text clamped for the DOM: a 30KB tool dump in an expanded card
    /// bloats the circuit diff and the layout; the full text lives in the session log.</summary>
    private string DisplayResult => Node.ResultText is { Length: > 4000 } text
        ? text[..4000] + $"\n… ({text.Length / 1024} KB total — truncated in UI; full text in the session log)"
        : Node.ResultText ?? "";

    /// <summary>First meaningful line of the result, for the collapsed row.</summary>
    private string ResultPreview
    {
        get
        {
            if (Node.ResultText is not { Length: > 0 }) return "";
            var line = Node.ResultText.Split('\n').Select(l => l.Trim()).FirstOrDefault(l => l.Length > 0) ?? "";
            if (line.Length == 0) return "";
            return line.Length > 90 ? line[..90] + "…" : line;
        }
    }

    private System.Text.Json.JsonElement? ArgsJsonElement
    {
        get
        {
            try
            {
                if (string.IsNullOrWhiteSpace(Node.ArgsJson)) return null;
                using var doc = System.Text.Json.JsonDocument.Parse(Node.ArgsJson);
                return doc.RootElement.ValueKind is System.Text.Json.JsonValueKind.Object or System.Text.Json.JsonValueKind.Array
                    ? doc.RootElement.Clone()
                    : null;
            }
            catch (System.Text.Json.JsonException)
            {
                return null;
            }
        }
    }

    /// <summary>True when the result text parses as a JSON object/array (tree-renderable).</summary>
    private System.Text.Json.JsonElement? ResultJson
    {
        get
        {
            if (!_resultParsed)
            {
                _resultParsed = true;
                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(Node.ResultText ?? "");
                    var kind = doc.RootElement.ValueKind;
                    if (kind is System.Text.Json.JsonValueKind.Object or System.Text.Json.JsonValueKind.Array)
                    {
                        _resultJson = doc.RootElement.Clone();
                    }
                }
                catch (System.Text.Json.JsonException) { }
            }
            return _resultJson;
        }
    }

    private void Toggle() => _expanded = !_expanded;

    private string CompactArgs
    {
        get
        {
            var text = PrettyArgs.Replace("\n", " ");
            return text.Length > 80 ? text[..80] + "…" : text;
        }
    }

    private string PrettyArgs
    {
        get
        {
            try
            {
                if (string.IsNullOrWhiteSpace(Node.ArgsJson)) return "{}";
                using var doc = System.Text.Json.JsonDocument.Parse(Node.ArgsJson);
                return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            }
            catch
            {
                return Node.ArgsJson ?? "";
            }
        }
    }
}
