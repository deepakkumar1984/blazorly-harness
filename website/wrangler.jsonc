{
  "name": "blazorly-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
